// 规范命名词典：canonical term -> aliases（历史/变体拼法）
// 校验扫描标识符与 meta 文案，命中 alias 时发 warning 建议规范形。
//
// 注意：Gateway 与 WistGateway 是不同概念（如 GatewayInstance 与
// WistGatewayInstance 并存），不塌缩；只归一大写拼法。
// WarpGateway / WarpGateWay 是 WistGateway 的历史拼法，保留为 alias 以兼容旧引用。

lexicon {
  term Gateway { aliases "GateWay" }
  term WistGateway { aliases "WarpGateway", "WarpGateWay" }
}
