// ═══════════════════════════════════════════
// Flow & Verify
// ═══════════════════════════════════════════

flow AgentStatusReportFlow {
  actor Control.Agentd
  trigger AgentStatusReport

  creates RuntimeHealthSnapshot

  step<stop> ReportHealth {
    create RuntimeHealthSnapshot {
      state = AgentStatusReport.agent_id
      updated_at = AgentStatusReport.version
    }
  }
}

flow ReportActionResultFlow {
  actor Control.Agentd
  trigger ReportActionResult

  creates ActionResultReceipt

  step<stop> AcceptActionResult {
    create ActionResultReceipt {
      report_id = ReportActionResult.report_id
      agent_id = ReportActionResult.agent_id
      accepted_at = ReportActionResult.reported_at
    }
  }
}

verify AgentStatusReportVerified for flow AgentStatusReportFlow {
  given {
    AgentStatusReport.agent_id = "agent-001"
    AgentStatusReport.version = "v1"
  }

  when AgentStatusReport

  expect {
    RuntimeHealthSnapshot.state == "agent-001"
  }
}

// 事实摘要→入库→派生清单→推断，一条流。
// 为什么派生清单与推断都是同一条流里的步而不是独立用例：事实变了才做，三者永远同序、无独立触发点；
// 将来规则表可热变、需要“按新规则重算存量”时再拆出独立流程。
flow IngestAgentFactSummaryFlow {
  meta {
    label zh "接收事实摘要、派生清单并推断用途"
    label en "Ingest Fact Summary, Derive Inventory and Infer Agent Purpose"
    summary zh "网关收到 agentd 的事实摘要：用 content_digest（网关自算）幂等入库（覆盖式，一台一条），再机械归并出软件清单，并按该机器平台的规则表算出用途建议与逐条依据。内容未变时只刷留痕、不重算。"
    tags "reporting", "agent-fact", "purpose", "ingest"
  }

  actor Control.Agentd
  trigger ReportAgentFactSummary

  // 推断要读该机器平台的规则表（数据在 content/purpose-rules.toml）。
  depends Control.PurposeRuleSet

  creates Control.AgentFactSummary
  creates Control.AgentSoftwareEntry
  creates Control.PurposeSignal
  creates Control.PurposeSuggestion

  step StoreFactSummary {
    create Control.AgentFactSummary {
      agent_id = ReportAgentFactSummary.agent_id
      // 不是照抄声明：网关用与 agentd 同一个实现从下列内容字段自算（声明只当版本金丝雀）。
      content_digest = ReportAgentFactSummary.content_digest
      // 以下三项仅留痕：内容未变时网关只刷它们，不改内容也不改幂等键。
      revision = ReportAgentFactSummary.revision
      observed_at = ReportAgentFactSummary.observed_at
      os = ReportAgentFactSummary.os
      arch = ReportAgentFactSummary.arch
      process_count = ReportAgentFactSummary.process_count
      process_executables = ReportAgentFactSummary.process_executables
      packages = ReportAgentFactSummary.packages
      listen_ports = ReportAgentFactSummary.listen_ports
      received_at = ReportAgentFactSummary.reported_at
    }
    next DeriveSoftwareInventory
  }

  // 机械归并：把可执行标识集合投影成清单行（按 agent 覆盖式重建）。
  // 只归并（路径 → 聚类键 + 展示名）、不识别 —— 识别要读目标机器上的文件，属采集侧（L1b）。
  // 与推断同在内容变化时发生：内容没变就没这一步，清单不重写。
  step DeriveSoftwareInventory {
    create Control.AgentSoftwareEntry {
      agent_id = ReportAgentFactSummary.agent_id
      software_key = "/Applications/Xcode.app"
      name = "Xcode"
      kind = App
      matched_rule = "macos-app-bundle"
      path = "/Applications/Xcode.app/Contents/MacOS/Xcode"
      received_at = ReportAgentFactSummary.reported_at
    }
    next InferPurpose
  }

  step<stop> InferPurpose {
    create Control.PurposeSignal {
      rule_id = "mac-dev-xcodebuild"
      kind = "process"
      value = "xcodebuild"
      weight = 40
    }

    create Control.PurposeSuggestion {
      suggestion_id = "suggestion-001"
      agent_id = ReportAgentFactSummary.agent_id
      suggested_class = MacDev
      confidence = 90
      method = "rule"
      rule_set_id = "macos-v1"
      signals = PurposeSignal
      observed_at = ReportAgentFactSummary.observed_at
    }
  }
}

verify AgentFactSummaryIngested for flow IngestAgentFactSummaryFlow {
  given {
    ReportAgentFactSummary.agent_id = "agent-001"
    ReportAgentFactSummary.content_digest = "sha256:fact-digest"
    ReportAgentFactSummary.revision = 7
    ReportAgentFactSummary.observed_at = "2026-09-22T00:00:00Z"
    ReportAgentFactSummary.os = "macos"
    ReportAgentFactSummary.arch = "arm64"
    ReportAgentFactSummary.process_count = 906
    ReportAgentFactSummary.process_executables = "xcodebuild|/opt/homebrew/bin/mise"
    ReportAgentFactSummary.packages = ""
    ReportAgentFactSummary.listen_ports = "5432"
    ReportAgentFactSummary.reported_at = "2026-09-22T00:00:01Z"
  }

  when ReportAgentFactSummary

  expect {
    Control.AgentFactSummary.agent_id == "agent-001"
    Control.AgentFactSummary.content_digest == "sha256:fact-digest"
    Control.AgentFactSummary.os == "macos"
    Control.AgentFactSummary.process_count == 906
    Control.PurposeSuggestion.confidence == 90
    Control.PurposeSuggestion.rule_set_id == "macos-v1"
    Control.AgentSoftwareEntry.agent_id == "agent-001"
    Control.AgentSoftwareEntry.software_key == "/Applications/Xcode.app"
    Control.AgentSoftwareEntry.matched_rule == "macos-app-bundle"
  }
}
