message<command> AgentStatusReport {
  agent_id: String
  instance_id: String
  version: String
  memory_bytes: Int?
  // **单核口径**：100% = 占满一个核（多线程可 >100）。只统计 agent 进程**自己**的 CPU 时间，
  // 不含它拉起的子进程。
  cpu_percent: Float?
  // 本机**逻辑核数**。与 cpu_percent 同一份上报：核数缺了，「这台机器被它占了百分之几」
  // 既算不出来也无法复核（4 核上的 13% 与 64 核上的 13% 不是一回事）。
  // 换算成整机占比由消费侧（gateway）做 —— agent 只交原始事实，派生值只留一处实现。
  cpu_cores: Int?
  admin_latency_ms: Int?
  // 本机**实际生效**的发现方向策略版本；空 = 还没拿到策略表（在用内建默认周期）。
  // 为什么由 agent 上报：网关知道自己**发布**了哪一版，但不知道哪台机器**拉到并应用**了哪一版
  // —— 拉取可能失败、可能还没到轮询节拍。运维要回答的正是「我改了策略，哪些机器还没生效」。
  discovery_policy_version: Int?
  // 本机**工作内容视图**（`state/work.json` 的同形子集）：我手里有哪些工作、各自在采哪些文件、
  // 一次性工作做到哪一步。网关知道自己**授权**了什么，但「真的在采哪些文件」只有 agent 知道
  // （本机手工加的输入、暂停、某条来源今天接不接得了）。空 = 这台 agent 还没报过。
  local_work: AgentLocalWork?
  // 本机**实际生效**的采集输出状态。网关知道自己**下发**了什么（AgentUplinkGrant），
  // 但不知道 agent **生效**成什么 —— grant 可能还没拉到、可能被本机总闸拦住、可能目标连不上。
  // 与 discovery_policy_version 同一类事实（「我发布了哪一版」≠「它生效了哪一版」）。
  // 空 = 旧版本 agent，还没报过。
  uplink_state: AgentUplinkState?
}

// Agent 实际生效的采集输出状态：与 Control.Agent.Work 的 AgentUplinkGrant 是一对
// （grant 说「控制面要它怎样」，这里说「它实际成了怎样」）。
struct AgentUplinkState {
  // 生效输出的总闸：false = 待命（不读源、不写本地采集输出、不上送日志/指标）。
  // 注意：**事实摘要不受此开关管** —— 待命期仍上报进程列表等推断元数据（仅 tcp 能承载）。
  enabled: Boolean
  // 生效输出类型：file | tcp（grant 覆盖本机 kind 之后的**结果**）。
  kind: String
  // 生效目标（tcp 且有目标时）。空 = 本地文件输出，或 tcp 但没有目标。
  target: String?
  // 这份生效状态的来源：grant（控制面下发）| local（未下发，用本机配置）。
  // 有了它，平台才能区分「控制面没启用」与「启用了但 agent 没听从」（后者才是故障）。
  source: String
  // 最近的出口写失败是否**尚未恢复**（细节在 agent 日志里：目标与原因）。
  output_write_failing: Boolean
}

// agentd 上报的**本机工作视图**（`state/work.json` 的子集：不带工作内容 —— 那是网关自己的事实）。
struct AgentLocalWork {
  recorded_at: String
  gateway_sequence: Int
  standing: List<AgentLocalStandingWork>
  one_shot: List<AgentLocalOneShotWork>
  // 本机配置里手工加的日志输入（运维逃生舱）：不来自任何采集面。
  local_inputs: List<AgentLocalTask>
  metrics_interval_seconds: Int?
}

// 一份常驻工作在本机的样子。
struct AgentLocalStandingWork {
  work_id: String
  family: String
  // active | paused（被撤回/被取代的不算「我手里的工作」）。
  status: String
  plan_version: Int
  // 我回报过的版本；空 = 还没回报（网关那边看到的就是漂移）。
  acknowledged_version: Int?
  effective_from: String
  tasks: List<AgentLocalTask>
}

// 本机一条采集任务：一个任务 id 盯一个路径。
struct AgentLocalTask {
  input_id: String
  path: String
  // head | tail：起读位置。授权采集一律 tail（不重放历史）。
  startup_position: String
}

// 一件一次性工作在本机的样子：status 是网关侧派发状态，execution 是本机执行状态。
struct AgentLocalOneShotWork {
  work_id: String
  action: String
  status: String
  execution: String
  scheduled_at: String
  deadline_at: String
  timeout_seconds: Int
}

message<response> AgentStatusAccepted {
  snapshot: RuntimeHealthSnapshot
}

command DispatchActionPlan {
  api_version
  kind
  unique dispatch_id
  plan
}

event ActionPlanAck {
  api_version
  kind
  dispatch_id
  action_id
  plan_digest
  agent_id
  instance_id
  execution_id
  ack_status
  reason_code
  reason_message
  queue_position
  received_at
  acknowledged_at
}

struct AckStatus {
  variant
}

struct ActionPlanAckBuilder {
  dispatch_id
  action_id
  plan_digest
  agent_id
  instance_id
  execution_id
  ack_status
  reason_code
  reason_message
  queue_position
  received_at
  acknowledged_at
}

message<command> ReportActionResult {
  api_version: String
  unique report_id: String
  kind: String
  dispatch_id: String
  action_id: String
  report_attempt: Int
  final_status: String
  execution_id: String
  plan_digest: String
  agent_id: String
  instance_id: String
  result_attestation: ResultAttestation
  reported_at: DateTime
  result: String
}

message<response> ActionResultAccepted {
  receipt: ActionResultReceipt
}

struct ActionResultReceipt {
  report_id: String
  agent_id: String
  accepted_at: DateTime
}

struct ResultAttestation {
  result_digest: String
  signature: String
  issued_by: String
  attested_at: DateTime
}

// 事实**原文快照**在数据面上的包体：agentd → 数据面（warp-parse）。
// 数据面作发布/订阅中枢：网关与中心**各自订阅**同一份帧，一次上报、两个消费者，互不代报
// （原先“网关再代报中心”的说法已废弃）。
// 帧族与摘要共用 `OBSFACT:` 标记（摘要见下方 ReportAgentFactSummary）；网关取摘要、中心取原文。
message<command> ReportDiscoverySnapshot {
  api_version: String
  kind: String
  unique report_id: String
  agent_id: String
  instance_id: String
  snapshot_id: String
  revision: Int
  generated_at: DateTime
  report_attempt: Int
  mode: DiscoveryReportMode
  snapshot: DiscoverySnapshot
  reported_at: DateTime
}

// 第一版只实现 FullSnapshot（完整快照幂等替换），不做 patch / delta。
variant DiscoveryReportMode {
  FullSnapshot
  SnapshotReplace
}

message<response> DiscoveryIngestAck {
  report_id: String
  agent_id: String
  instance_id: String
  snapshot_id: String
  revision: Int
  ack_status: DiscoveryIngestAckStatus
  ingested_resources: Int
  ingested_targets: Int
  received_at: DateTime
  ack_at: DateTime
  reason_code: String?
  reason_message: String?
}

// accepted（已落地）| duplicate（同快照已处理）| stale（revision 落后）| rejected（envelope/身份非法）
variant DiscoveryIngestAckStatus {
  Accepted
  Duplicate
  Stale
  Rejected
}

// 事实**摘要**的上报：agentd → 数据面 → **网关订阅**（复用 agent 身份，见信封的 `agent`）。
//
// 与原文快照**同一条通道、不同载荷**（2026-09-22 定，取代原先的“摘要走控制面”分流）：
//   摘要 —— 去重后 10~30 KB，订阅方是网关，用于用途推断与页面；
//   原文 —— 一台几百 KB，订阅方是中心，用于资产整理。
// 统一的原因：两者都是**观测数据**，只是粒度不同；分两条上行通道就是两套连接、两套节流、两套失败模式。
// 统一的前提是**给数据面接入加身份校验**（原先把摘要留在控制面，唯一理由就是数据面无鉴权）。
message<command> ReportAgentFactSummary {
  api_version: String
  kind: String
  unique report_id: String
  agent_id: String
  instance_id: String
  // agent 声明的**内容摘要**。不是判重键：网关从下列内容字段自算，
  // 声明与自算不一致时只记告警（可能是版本偏差，不据此拒收）。
  // agentd 无条件周期全量上报（模式与规则见 doc/design/center/discovery-reporting-modes.md）。
  content_digest: String
  // 仅留痕：快照 revision 每轮无条件 +1。
  revision: Int
  observed_at: DateTime
  os: String
  arch: String
  process_count: Int
  process_executables: List<String>
  // 已装包名。探针尚未实现（agentd 侧无 package 探针），故此列恒空 ——
  // 空表示「没采」，不是「没装」。
  packages: List<String>
  listen_ports: List<String>
  // 留痕/展示（不进内容摘要、不参与判重）：机器名与 IP 会变，但不改变用途判据。
  host_id: String
  host_name: String
  network_addresses: List<String>
  reported_at: DateTime
}

// accepted（已入库）| duplicate（网关按**自算**摘要判定内容未变：只刷留痕，不重算）| rejected（envelope/身份非法）
variant FactSummaryAckStatus {
  Accepted
  Duplicate
  Rejected
}

message<response> FactSummaryAccepted {
  report_id: String
  agent_id: String
  content_digest: String
  ack_status: FactSummaryAckStatus
  // 幂等命中（duplicate）时仍回带已存建议，Agent 侧不必再问一次。
  suggestion_id: String?
  received_at: DateTime
}

// 拉取**发现方向策略表**：agentd → 网关（复用 agent 凭据，已认证）。
//
// 为什么是「拉」而不是网关推：agentd 没有入站监听（那要开端口、要证书、要处理公网可达），
// 而策略是**幂等内容**（声明式、可重复拉取，与 PollWork 同类）—— 拉一次就够，不必重放。
// 为什么不需要 wait_ms（PollControlCommands 有）：那是长轮询指令流；策略表按版本变化，
// 拉取周期由 agentd 自己控（它知道自己能承受多密）。
message<command> PollDiscoveryPolicies {
  api_version: String
  kind: String
  agent_id: String
  instance_id: String
  requested_at: DateTime
}

// 网关返回的策略表。带 policy_version：agentd 靠它判断「与我手上的是不是同一版」，
// 从而在版本未变时跳过重新应用（而不是每轮都重算一遍）。
message<response> DiscoveryPoliciesReturned {
  policy_version: Int
  published_at: DateTime
  policies: List<Discovery.Probe.DiscoveryAspectPolicy>
  returned_at: DateTime
}

event IngestHeadError {
  reason
  detail
}
