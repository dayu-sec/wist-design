struct ObservedProcess {
  pid
  comm
  cmdline
}

struct ObservedNetworkInterface {
  name
  mtu
}

struct ObservedIpAddress {
  address
  netmask
}

struct ObservedServiceEndpoint {
  address
  port
  protocol
}

struct ObservedContainer {
  unique container_id
  name
  image
}

struct ObservedFileIdentity {
  path
  inode
}

struct OciRuntimeSpec {
  version
}

struct OciLinuxSpec {
}

struct ContainerRuntimeRoot {
  path
  kind
}

struct ProcessSocketOwner {
  pid
  fd
}

struct AddressFamily {
  variant
}

struct SocketTableKind {
  variant
}

// 发现**来源**：数据是怎么拿到的，与“发现方向”（探测哪一类，见 Discovery.Probe.DiscoveryAspect）
// 是两个正交的轴，不要混。
variant DiscoverySourceKind {
  LocalRuntime
  Static
  File
  K8s
}
