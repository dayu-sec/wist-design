// 直发（不经 spool）这一步的产出：三条计数 + 失败原文。
struct DeliveryOutcome {
  records_processed: Int
  emitted_directly: Int
  spooled: Int
  // 直发这一步失败的原因（已含目标地址）；记录已转入 spool。
  sink_error: String?
}
