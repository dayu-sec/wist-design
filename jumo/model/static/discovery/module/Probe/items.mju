struct DiscoveryProbe {
}

// 发现方向：探测“哪一类事实”的闭集。与 DiscoverySourceKind（数据是**怎么**拿到的：本地运行时/静态/文件/K8s）
// 是两个正交的轴。探针侧目前只是裸字符串（"host"/"process"…），这里把它定成闭集。
// 加方向 = 改模型（它决定读本机哪些状态，牵涉权限与负载）。
variant DiscoveryAspect {
  meta {
    label zh "发现方向"
    label en "Discovery Aspect"
    summary zh "探测哪一类事实：主机资源、进程、容器、监听端口、网络、K8s 工作负载、已装包。"
    tags "discovery", "probe", "aspect"
  }

  Host
  Process
  Container
  Endpoint
  Network
  K8s
  Package
}

// 每个方向的策略：**观测**周期与允许区间、是否基线、是否默认开、适用平台、产出什么事实。
//
// 值**不在模型里**：jumo 装不下常量（字段默认值解析通过但不落实例；同一类型的多条记录
// 无法逐条 verify），硬塞进 flow + create 只会把「为什么这么定」压成注释、改策略还要动模型。
// 值放 `content/aspect-policies.toml` —— 与用途规则表（`Control.Agent.Purpose.PurposeRuleSet`）
// **同一约定**：模型留结构与字段语义，值留 content/；由网关装载校验（区间、基线不可关、平台）
// 后下发给 agentd。
//
// 载本表**刻意不建模**「上报范围 × 上报触发」（全量/TOP × 变化/周期）：那是一张
// 「策略 × 规则 × 逐方向取值」的表，塞进类型只会把理由压成注释；规则与逐方向取值放文档
// doc/design/center/discovery-reporting-modes.md。

struct DiscoveryAspectPolicy {
  meta {
    label zh "发现方向策略"
    label en "Discovery Aspect Policy"
    summary zh "单个发现方向的观测周期与开关策略：默认/最小/最大周期、是否基线不可关、适用平台、产出哪些事实。"
    tags "discovery", "probe", "policy"
  }

  unique aspect: DiscoveryAspect
  // **观测**周期（秒）：多久采一次。发现是慢变量，量级应比采集低 1~2 个（采集是 15s 级）。
  // 注意它与「上报周期」是两件事：采得密是为了少漏检，报得疏是为了不噪声。
  default_interval_seconds: Int
  // 允许区间（秒）：改这个方向时不得越界（采得太密会把被管机器拖住，太疏则失去观测意义）。
  min_interval_seconds: Int
  max_interval_seconds: Int
  // 基线面：不可关（它回答“我是什么”，是自识别与派活的底座）——
  // 所以装载校验要求 `baseline` 的方向必须 `enabled_by_default`。
  baseline: Boolean
  // 未显式声明时的默认开关（`[discovery] *_enabled` 未配置时生效）。
  enabled_by_default: Boolean
  // 适用平台。声明了却永远产出为空的方向不该报（如 Endpoint 的 macOS 侧是空实现）。
  platforms: List<String>
  // 产出的事实（供人理解“为什么要这个面”），如 host = os/arch/核数/内存/磁盘/GPU。
  yields: String
}

// 一版策略表：版本 + 发布时间 + 各方向策略。
// 形状与 `Control.Agent.Purpose.PurposeRuleSet` 对齐 —— 它是**同一种东西**：
// 平台策展、按版本发布、**改内容必须 bump 版本**（两侧靠版本号判断谁过期了）。
struct DiscoveryAspectPolicySet {
  meta {
    label zh "发现方向策略表"
    label en "Discovery Aspect Policy Set"
    summary zh "一版发现方向策略：版本号、发布时间与各方向的策略。"
    tags "discovery", "probe", "policy"
  }

  unique policy_version: Int
  published_at: DateTime
  policies: List<DiscoveryAspectPolicy>
}

// 管理面看当前生效的策略表（视图类型在 Control 域：它是网关管理面的读模型）。

struct HostDiscoveryProbe {
  kind
}

struct NetworkDiscoveryProbe {
  kind
}

struct EndpointDiscoveryProbe {
  kind
}

struct ProcessDiscoveryProbe {
  kind
}

struct ContainerDiscoveryProbe {
  kind
}

struct K8sDiscoveryProbe {
  kind
}

struct ProbeOutput {
  source
  probe
  resources
  targets
}

struct DiscoveryProbeError {
  source
  probe
  detail
}

struct DiscoveryRuntime {
  probes
}

struct DiscoveryRefreshResult {
  refreshed_snapshot
  persisted_snapshot
  used_cached_snapshot
  had_successful_refresh
  errors
  last_success_at
  last_error
  store_failure
  successful_probes
}

struct SuccessfulProbeRefresh {
  source
  probe
  resource_count
  target_count
}

struct DiscoveryStoreFailure {
  phase
  detail
}

struct DiscoveryCachePaths {
  snapshot_path
  meta_path
}

struct DiscoveryCacheLoadFailure {
  phase
  detail
}
