// Control domain HTTP bindings

bind WistGatewayPublicInstallInterface {
  entry AdminGetAgentInstallCode {
    route GET "/api/v1/agent/install-code"
    auth bearer
    actor_identity OperationsEngineer.id from token.sub
    status AgentInstallCode 200
  }

  entry GatewayContainerInstallRequested {
    route POST "/api/v1/gateway/container-install"
    auth bearer
    actor_identity CustomerServiceEngineer.id from token.sub
    status GatewayInstallReceipt 202
  }

  entry GatewayImageDownloadRequested {
    route POST "/api/v1/gateway/image-download"
    auth bearer
    actor_identity CustomerServiceEngineer.id from token.sub
    status GatewayImageDownloadReceipt 202
  }

  entry InitializeGatewayViaUrl {
    route POST "/api/v1/gateway/initialize-via-url"
    auth bearer
    actor_identity CustomerServiceEngineer.id from token.sub
    status GatewayInitialConfig 200
  }
}

bind WistGatewayManagementInterface {
  entry AdminShowAgentRuntimeStatus {
    route GET "/api/v1/admin/agents/{agent_id}/runtime-status"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentRuntimeStatus 200
  }

  entry AdminGetAgentOverview {
    route GET "/api/v1/admin/agents/overview"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentOverview 200
  }

  // 主机资源指标（单台）：指标取自 VM，身份 join 注册表；未知 agent 回 404。
  entry AdminShowAgentHostMetrics {
    route GET "/api/v1/admin/agents/{agent_id}/host-metrics"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentHostMetrics 200
  }

  // 机队主机指标（列表）：一行一台有指标上报的主机，带注册表身份。
  entry AdminListAgentHostMetrics {
    route GET "/api/v1/admin/agents/host-metrics"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status List<AgentHostMetricsSummary> 200
  }

  entry AdminViewGatewayManagementState {
    route GET "/api/v1/admin/gateway/management-state"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewayManagementState 200
  }

  entry AdminSetGatewayLinkRequest {
    route POST "/api/v1/admin/gateway/link-request"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewayLinkRequestView 200
  }

  entry AdminViewGatewayLinkRequest {
    route GET "/api/v1/admin/gateway/link-request"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewayLinkRequestView 200
  }

  entry AdminViewGatewayLinkdStatus {
    route GET "/api/v1/admin/gateway/linkd-status"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewayLinkdStatusView 200
  }

  entry AdminViewGatewaySelfState {
    route GET "/api/v1/admin/gateway/self-state"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewaySelfState 200
  }

  entry AdminLookupAgentRegistryEntry {
    route GET "/api/v1/admin/agents/{agent_id}/registry-entry"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentRegistryEntry 200
  }

  entry AdminQueryAgentCapabilityIndex {
    route GET "/api/v1/admin/agents/{agent_id}/capability-index"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentCapabilityIndex 200
  }

  entry DispatchAgentFleetCommand {
    route POST "/api/v1/gateway/agents/dispatch"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentFleetDispatchReceipt 202
  }

  entry AdminListAgents {
    route GET "/api/v1/admin/agents"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status Projection<List<AgentRuntimeStatus>> 200
  }

  entry AdminRevokeAgentCredential {
    route POST "/api/v1/admin/agents/{agent_id}/credentials:revoke"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentCredentialRevocationResult 200
  }

  entry AdminSetAgentInstallPackageAddress {
    route POST "/api/v1/admin/agent/install-package"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status AgentInstallPackageAddress 200
  }

  entry AdminViewAgentInstallPackageAddress {
    route GET "/api/v1/admin/agent/install-package"
    auth bearer
    actor_identity OperationsEngineer.id from jwt.sub
    status AgentInstallPackageAddress 200
  }

  entry AdminListAgentInstallPackages {
    route GET "/api/v1/admin/agent/install-packages"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status Projection<List<AgentInstallPackageHistoryEntry>> 200
  }

  // 删除一台**离线** Agent（不可恢复）。在线 → 409（判据与列表/运行态同一处）。
  entry AdminDeleteAgent {
    route DELETE "/api/v1/admin/agents/{agent_id}"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentDeletionResult 200
  }

  // 按 agent_id 的拒绝名单（吊销，§5.6）：与 AdminRevokeAgentCredential 不同 ——
  // 那个吊销一份凭据（可换凭据 / 证书自续绕开），这个拒的是 agent_id 本身。
  entry AdminRevokeAgent {
    route POST "/api/v1/admin/agents/{agent_id}/revocation"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentCertificateDenylistEntry 200
  }

  entry AdminLiftAgentRevocation {
    route DELETE "/api/v1/admin/agents/{agent_id}/revocation"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentRevocationLiftedResult 200
  }

  entry AdminListAgentRevocations {
    route GET "/api/v1/admin/agent-revocations"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status Projection<List<AgentCertificateDenylistEntry>> 200
  }

  entry AdminViewAgentPurpose {
    route GET "/api/v1/admin/agents/{agent_id}/purpose"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentPurposeView 200
  }

  // 人工判定：落 AgentClassification（采纳建议或改判）。分类必须与机器平台一致，实现层校验。
  entry AdminClassifyAgent {
    route POST "/api/v1/admin/agents/{agent_id}/classification"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentClassification 200
  }

  // 机队用途覆盖度：各类别台数与未归类台数。
  entry AdminViewPurposeCoverage {
    route GET "/api/v1/admin/agents/purpose-coverage"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status FleetPurposeCoverage 200
  }

  // 按机器看软件：从事实摘要机械归并出的清单。未知 agent 回 404，
  // 「有 agent 但没上报过清单」= 200 + 空清单 + 计数 0（两者必须能区分）。
  entry AdminViewAgentSoftware {
    route GET "/api/v1/admin/agents/{agent_id}/software"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentSoftwareInventory 200
  }

  // 按软件看机器：机队聚合，受 limit 约束。
  entry AdminViewSoftwareHoldings {
    route GET "/api/v1/admin/software"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status SoftwareHoldings 200
  }

  // 看当前生效的发现方向策略表：表是平台策展数据，运维需要能看到“现在生效的是哪一版”。
  entry AdminViewDiscoveryPolicies {
    route GET "/api/v1/admin/discovery-policies"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status DiscoveryPolicyView 200
  }

  // 灰度发布计划（网关 → agentd）：把一个动作（action + spec）按阶段（灰度）铺到机队，
  // 批准后按阶段展开成一件件一次性工作（交付走 PollWork，结果走 ReportWorkResult 回填）。
  entry AdminCreateRolloutPlan {
    route POST "/api/v1/admin/rollout-plans"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status RolloutPlan 201
  }

  entry AdminListRolloutPlans {
    route GET "/api/v1/admin/rollout-plans"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status List<RolloutPlan> 200
  }

  entry AdminApproveRolloutPlan {
    route POST "/api/v1/admin/rollout-plans/approve"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status RolloutPlan 200
  }

  entry AdminAdvanceRolloutPlan {
    route POST "/api/v1/admin/rollout-plans/advance"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status RolloutPlan 200
  }

  entry AdminViewRolloutPlan {
    route GET "/api/v1/admin/rollout-plans/{plan_id}"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status RolloutPlanView 200
  }
}

bind WistAgentdOnlineRegistrationInterface {
  entry SubmitEnrollmentRequest {
    route POST "/api/v1/agent/enroll"
    auth none
    status AgentEnrollmentResult 201
  }

  entry SubmitAgentStatus {
    route POST "/api/v1/agent/status"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status Reporting.AgentStatusAccepted 202
    outcome Reporting.AgentStatusAccepted on Reporting.AgentStatusAccepted
  }

  entry RenewAgentCredential {
    route POST "/api/v1/agent/credentials:renew"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status CredentialBundle 200
  }

  entry PollControlCommands {
    route POST "/api/v1/agent/control-commands:poll"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status AgentControlCommandsReturned 200
    outcome AgentControlCommandsReturned on ControlCommandsReturned
  }

  // 一次性工作的执行结果（进度/终态）。与 ack 分开一条路由：确认回答「我收到了」，
  // 结果回答「我做得怎么样了」—— 两者失效的代价不同，不挤一条路。
  entry ReportWorkResult {
    route POST "/api/v1/agent/work:result"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status WorkResultAccepted 200
  }

  entry ReportActionResult {
    route POST "/api/v1/agent/action-results"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status Reporting.ActionResultAccepted 202
    outcome Reporting.ActionResultAccepted on Reporting.ActionResultReceipt
  }

  // （事实摘要**不再**走本接口：agentd 把它作为 `OBSFACT:` 帧上送数据面，网关订阅。）
  // 这里刻意不建对应 entry：接收端是网关的**内部**监听（明文、仅绑环回），它不属于
  // 「agent 在线注册」这个面向 agent 的接口；而它的身份校验尚未落地（见计划 §8 #17），
  // 现在写一条 `auth none` 的 entry 会把「目标形态」记成「无鉴权」，反而是假的。
  // 详见 doc/design/center/agent-work-delivery-plan.md §4.1。

  // 工作授权的拉取与确认：本接口最早的条目，但**一直没有 `bind`**。
  // 后果：模型不记录它们的 route/auth/status，codegen 也无从生成，三条 agent 路由
  // （含下面的 uplink:poll）只能手加 —— 任何一次“重新生成控制面代码”都会丢掉它们。
  entry PollWork {
    route POST "/api/v1/agent/work:poll"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status WorkGrant 200
  }

  entry AckWork {
    route POST "/api/v1/agent/work:ack"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status WorkAccepted 200
  }

  // 数据面上送授权：与 work:poll 同类（幂等、可重复拉取），刻意走**独立端点**。
  entry PollAgentUplink {
    route POST "/api/v1/agent/uplink:poll"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status AgentUplinkGrant 200
  }

  // 拉取发现方向策略表：网关未配表时回 503（“未发布”与“没配”必须能区分），
  // agentd 遇到 503 就继续用自己的内建周期，不是错误。
  entry PollDiscoveryPolicies {
    route POST "/api/v1/agent/discovery-policies:poll"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status Reporting.DiscoveryPoliciesReturned 200
  }
}

bind WistCenterGatewayInterface {
  entry RegisterGateway {
    route POST "/api/v1/gateway/register"
    auth none
    status GatewayEnrollmentResult 200
  }

  entry LinkUpstream {
    route GET "/api/v1/gateway/link-upstream"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayInitialConfig 200
  }

  entry ReportGatewayStatus {
    route POST "/api/v1/gateway/status"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayStatusAccepted 200
  }

  entry ReportAgentStatus {
    route POST "/api/v1/gateway/agents/status"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status AgentStatusAcceptedReturned 200
  }

  entry RenewGatewayCredential {
    route POST "/api/v1/gateway/credentials:renew"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayCredentialBundle 200
  }

  entry VerifyGatewayCredential {
    route POST "/api/v1/gateway/credentials/verify"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayCredentialVerificationResult 200
  }

  entry QueryGatewayInitializationStatus {
    route GET "/api/v1/gateway/initialization-status"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayInitializationStatus 200
  }

  entry GetGatewayUpgradePlan {
    route GET "/api/v1/gateway/upgrade-plan"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayUpgradePlan 200
  }

  entry ReportGatewayUpgradeResult {
    route POST "/api/v1/gateway/upgrade-result"
    auth bearer
    actor_identity WistGateway.id from credential.gateway_id
    status GatewayUpgradeResultAccepted 200
  }
}

bind GatewayProvisioningInterface {
  entry AdminCreateGatewayInstance {
    route POST "/api/v1/admin/gateways/instances"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayInstance 201
  }

  entry AdminBindGatewayCustomer {
    route POST "/api/v1/admin/gateways/bind"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayCustomerBinding 200
  }
}

bind GatewayOpsInterface {
  entry AdminViewGatewayList {
    route GET "/api/v1/admin/gateways"
    auth bearer
    actor_identity GatewayOperator.id from jwt.sub
    status Projection<List<GatewayInstance>> 200
  }

  entry AdminShowGatewayStatus {
    route GET "/api/v1/admin/gateways/{gateway_id}/status"
    auth bearer
    actor_identity CustomerServiceEngineer.id from jwt.sub
    status GatewayRuntimeStatus 200
  }

  entry AdminListGatewayStatus {
    route GET "/api/v1/admin/gateways/status"
    auth bearer
    actor_identity CustomerServiceEngineer.id from jwt.sub
    status List<GatewayRuntimeStatus> 200
  }

  entry AdminListGatewayInstances {
    route GET "/api/v1/admin/gateways/instances"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status List<GatewayInstance> 200
  }

  entry AdminGetGatewayUptime {
    route GET "/api/v1/admin/gateways/{gateway_id}/status/uptime"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status Projection<GatewayRuntimeStatus> 200
  }

  entry AdminGetGatewayHistory {
    route GET "/api/v1/admin/gateways/{gateway_id}/status/history"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status Projection<List<GatewayRuntimeStatus>> 200
  }

  entry AdminGetGatewayLifecycle {
    route GET "/api/v1/admin/gateways/{gateway_id}/lifecycle"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status List<GatewayLifecycleEvent> 200
  }

  entry AdminGetGatewayInitialConfig {
    route GET "/api/v1/admin/gateways/{gateway_id}/config"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status GatewayInitialConfig 200
  }

  entry AdminGetAgentHistory {
    route GET "/api/v1/admin/gateways/{gateway_id}/agents/{agent_id}/history"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status Projection<List<AgentRuntimeStatus>> 200
  }

  entry AdminListGatewayAgents {
    route GET "/api/v1/admin/gateways/{gateway_id}/agents"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status List<AgentRuntimeStatus> 200
  }
}

bind PlatformReleaseInterface {
  entry AdminDispatchGlobalPolicy {
    route POST "/api/v1/admin/policies/global"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status GlobalPolicyDispatch 200
  }

  entry AdminPublishRelease {
    route POST "/api/v1/admin/releases/{component}"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status Projection<WistGatewayRelease> 201
  }

  entry AdminListReleases {
    route GET "/api/v1/admin/releases/{component}"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status List<WistGatewayRelease> 200
  }

  entry AdminCreateUpgradePlan {
    route POST "/api/v1/admin/rollout-plans"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status RolloutPlan 201
  }

  entry AdminListUpgradePlans {
    route GET "/api/v1/admin/rollout-plans"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status List<RolloutPlan> 200
  }

  entry AdminApproveUpgradePlan {
    route POST "/api/v1/admin/rollout-plans/approve"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status RolloutPlan 200
  }

  entry AdminAdvanceUpgradePlan {
    route POST "/api/v1/admin/rollout-plans/advance"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status RolloutPlan 200
  }

  entry AdminViewUpgradePlan {
    route GET "/api/v1/admin/rollout-plans/{plan_id}"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status RolloutPlanView 200
  }
}
