// Module: GatewayManagement — 网关自身管理域
//
// WistGateway 控制平台自身的领域事实：网关实例、控制面配置与健康状态。
// 区别于 insightcenter 层 GatewaySupervision 从中心侧对网关的接入与聚合。

struct WistGatewayInstance {
  meta {
    label zh "WistGateway 实例"
    label en "WistGateway Instance"
    tags "gateway", "instance"
  }

  unique gateway_id: String
  instance_id: String
  boot_id: String
  version: String
  started_at: DateTime
  last_seen_at: DateTime
}

struct GatewayControlConfig {
  meta {
    label zh "网关控制面配置"
    label en "Gateway Control Config"
    tags "gateway", "config"
  }

  unique config_id: String
  gateway_id: String
  advertise_url: String
  enrollment_url: String
  gateway_url: String
  telemetry_url: String
  updated_at: DateTime
}

struct GatewayHealth {
  meta {
    label zh "网关健康状态"
    label en "Gateway Health"
    tags "gateway", "health"
  }

  gateway_id: String
  status: String
  reported_at: DateTime
}

struct GatewayManagementState {
  meta {
    label zh "网关管理状态视图"
    label en "Gateway Management State View"
    tags "gateway", "management", "self-management"
  }

  gateway_id: String
  instance_id: String
  version: String
  status: String
  config: GatewayControlConfig
  health: GatewayHealth
  last_seen_at: DateTime
}


// 管理面看当前生效的发现方向策略表。
//
// 为什么视图在 Control 域而不是 Discovery：它是**网关管理面的读模型**，
// 与 GatewayManagementState 同类；但它的内容是 Discovery 域的对象（跨域引用）。
struct DiscoveryPolicyView {
  meta {
    label zh "发现方向策略视图"
    label en "Discovery Policy View"
    summary zh "管理面看当前生效的发现方向策略表：是否已配置，以及生效的那一版内容。"
    tags "discovery", "policy", "view", "admin"
  }

  // 为什么带 `configured`：网关**没配**表时就不提供下发端点（agent 回退内建默认值），
  // 运维必须能区分「没配」与「配了一版空表」—— 后者不是合法状态（装载校验会拒）。
  configured: Boolean
  // 未配置时为空。
  policy: Discovery.Probe.DiscoveryAspectPolicySet?
  generated_at: DateTime
}

command ViewGatewayManagementState = OperatorRequest {
  meta {
    label zh "查看网关管理状态"
    label en "View Gateway Management State"
    tags "gateway", "management"
  }

}
