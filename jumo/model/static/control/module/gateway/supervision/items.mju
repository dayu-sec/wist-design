// Module: GatewaySupervision — WistGateway 上级聚合
// 覆盖 WistGateway 实例接入 WistCenter 的初始配置获取、状态上报与状态/实例/客户/列表视图实体。

struct GatewayImage {
  meta {
    label zh "网关镜像"
    label en "Gateway Image"
    summary zh "WistGateway 部署用的容器镜像（docker pull / docker run 对象），下载后启动容器实例；携带摘要、签名与独立信任锚（发行方签名者 signer_id + 中心签发的 release manifest），安装前按信任锚校验完整性，防投毒镜像与循环信任。"
    tags "gateway", "deployment", "image"
  }

  image_ref: String
  version: String
  image_digest: String
  image_signature: String
  signer_id: String
  release_manifest_ref: String
}

struct GatewayInitialConfig {
  meta {
    label zh "Gateway 初始配置"
    label en "Gateway Initial Config"
    summary zh "WistGateway 初始化所需的安全连接配置：网关身份、控制中心端点、TLS 信任包、协议版本与注册 Token 引用（策略/遥测待定）。config.toml 即其序列化。"
    tags "gateway", "config"
  }

  gateway_id: String
  instance_id: String?
  control_center_endpoint: String
  trust_bundle: ControlCenterTrustBundle?
  server_tls_required: Bool
  protocol_version: String
  enrollment_token_id: String
}

struct GatewayStatusAccepted {
  meta {
    label zh "Gateway 状态已接收"
    label en "Gateway Status Accepted"
    tags "gateway", "status"
  }

  gateway_id: String
  instance_id: String
  accepted_at: DateTime
}

// Gateway 运行态领域事实（注册后的版本/状态/健康/最近上报），非 View DTO。
struct GatewayRuntimeStatus {
  meta {
    label zh "Gateway 运行状态"
    label en "Gateway Runtime Status"
    tags "gateway", "status", "runtime"
  }

  unique gateway_id: String
  instance_id: String
  // 网关**对外基址**（对外域名）：管理面「对外地址」优先，未设回落本机 `[server] public_base_url`。
  // 由网关状态上报带来；中心据此知道「这个网关对外是哪个域名」。
  public_base_url: String?
  version: String?
  status: String?
  health: String?
  memory_bytes: Int?
  cpu_percent: Float?
  last_seen_at: DateTime
  // 富化（见设计 edge/gateway-status-report.md）：机队聚合 + 进程运行时长。
  uptime_seconds: Int?
  agent_count: Int?
  online_agents: Int?
  offline_agents: Int?
  last_seen_lag_seconds: Int?
  // 存储 / 数据面 / 主机资源（富化，见设计 edge/gateway-status-report.md）。
  store_bytes: Int?
  ingest_accepted_total: Int?
  ingest_rejected_total: Int?
  last_ingest_at: DateTime?
  memory_total_bytes: Int?
  load_1m: Float?
  load_5m: Float?
  load_15m: Float?
  disk_usage_percent: Float?
  disk_total_bytes: Int?
  disk_available_bytes: Int?
}

variant GatewayInstanceLifecycleState {
  meta {
    label zh "Gateway 实例生命周期状态"
    label en "Gateway Instance Lifecycle State"
    tags "gateway", "lifecycle", "provisioning"
  }

  Provisioned
  Initializing
  Running
  Failed
}

struct GatewayInstance {
  meta {
    label zh "Gateway 管理实例"
    label en "Gateway Instance"
    tags "gateway", "provisioning"
  }

  gateway_id: String
  instance_id: String
  lifecycle_state: GatewayInstanceLifecycleState
  created_at: DateTime
  initialized_at: DateTime?
}

struct GatewayCustomerBinding {
  meta {
    label zh "Gateway 客户绑定"
    label en "Gateway Customer Binding"
    tags "gateway", "provisioning", "customer"
  }

  gateway_id: String
  customer_id: String
  status: String
  bound_at: DateTime
}

struct GlobalPolicyDispatch {
  meta {
    label zh "全局策略下发回执"
    label en "Global Policy Dispatch"
    tags "center", "policy"
  }

  unique dispatch_id: String
  policy_version: String
  target_count: Int
  status: String
  dispatched_at: DateTime
}

// ── 网关接入（forGateway：WistGateway 实例 → WistCenter） ──

// 网关面身份以 gateway_id 为准（见 binding 的 actor_identity ... from credential.gateway_id）：
// 调用方在 init 时以 gateway_id 标识自己；instance_id 是**置备域**标签，不作网关面查询键。
message<command> LinkUpstream {
  gateway_id: String
  requested_at: DateTime
}

// 取「该网关该升到哪一版」：有覆盖本网关的已批准升级计划 → 给目标；否则 has_plan=false。
message<query> GetGatewayUpgradePlan {
  gateway_id: String
}

struct GatewayUpgradePlan {
  meta {
    label zh "网关升级目标"
    label en "Gateway Upgrade Plan"
    summary zh "该网关当前应升到的目标（来自覆盖它的已批准升级计划）；无计划时 has_plan=false。"
    tags "gateway", "upgrade", "plan"
  }

  gateway_id: String
  has_plan: Bool
  plan_id: String?
  component: String?
  to_version: String?
  // 中心**派生**的制品下发地址（镜像后的可下载 URL）。执行器据此取件（gops `--to <url>`）；
  // 缺省 = 没有对应 release 记录，执行器回落用 `to_version`。见设计 edge/gateway-upgrade-and-releases.md。
  artifact_url: String?
  // 计划动作（`upgrade` / `push-agent-package`）。缺省 = 老中心，按 `upgrade` 处理；
  // gwlinkd 据此分派执行器：升级走 gops，包下发环回写网关包管理。见设计 edge/agent-package-push-to-gateways.md。
  action: String?
  // `artifact_url` 的期望摘要（sha256）。**仅**「agent 包下发」（②）带它；① 升级路径为空。
  artifact_sha256: String?
  // 「agent 包下发」（②）的**多平台**制品清单：该版本**全部平台**的地址 + 摘要。
  // ② 要网关替 **Agent 机队**托管各平台的包（机队平台可能 ≠ 网关自己主机的平台），故用列表；
  // ① 升级仍用单值 artifact_url（网关本机就一个平台）。见设计 edge/agent-package-push-to-gateways.md。
  artifacts: List<GatewayUpgradeArtifact>
}

struct GatewayUpgradeArtifact {
  meta {
    label zh "网关升级制品（单平台）"
    label en "Gateway Upgrade Artifact"
    summary zh "「Agent 包下发」（②）里的一个平台制品：平台（target-triple）+ 中心派生地址 + 期望摘要。"
    tags "gateway", "upgrade", "artifact"
  }

  platform: String
  artifact_url: String
  artifact_sha256: String
}

// 升级结果回执（字段对齐 agentd / gops 的 upgrade.json）。
message<command> ReportGatewayUpgradeResult {
  gateway_id: String
  work_id: String
  from_version: String
  to_version: String
  step: String
  status: String
  detail: String
  reported_at: DateTime
}

message<response> GatewayUpgradeResultAccepted {
  gateway_id: String
  work_id: String
  accepted_at: DateTime
}

message<command> InitializeGatewayViaUrl {
  init_url: String
  requested_at: DateTime
}

message<command> ReportGatewayStatus {
  gateway_id: String
  instance_id: String
  // 网关**对外基址**（对外域名）：管理面「对外地址」优先，未设回落本机 `[server] public_base_url`。
  // 可选 —— 老网关不带这个键，中心侧 serde default 兜底。
  public_base_url: String?
  version: String
  // 在线/离线：`online` / `offline`（中心按 `== "online"` 计数与展示，别用 `running`）。
  status: String
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  reported_at: DateTime
  // ── 富化字段（可选；老网关不带这些键，中心侧 serde default 兜底）。
  // 见设计 edge/gateway-status-report.md（与自述面 GatewaySelfState 同一份值）。
  uptime_seconds: Int?
  agent_count: Int?
  online_agents: Int?
  offline_agents: Int?
  last_seen_lag_seconds: Int?
  store_bytes: Int?
  ingest_accepted_total: Int?
  ingest_rejected_total: Int?
  last_ingest_at: DateTime?
  memory_total_bytes: Int?
  load_1m: Float?
  load_5m: Float?
  load_15m: Float?
  disk_usage_percent: Float?
  disk_total_bytes: Int?
  disk_available_bytes: Int?
}

// ── 安全注册（forGateway：预共享 Token → 身份/凭据签发，参考 Agentd） ──

struct GatewayEnrollmentResult {
  meta {
    label zh "网关注册结果"
    label en "Gateway Enrollment Result"
    summary zh "WistGateway 安全注册的回执：签发身份、凭据与初始配置引用。"
    tags "gateway", "enrollment", "result"
  }

  status: String
  gateway_id: String
  instance_id: String
  credential_id: String
  initial_config: String
  // 注册成功同时签发长期凭据（客户端证书）——网关侧必须拿到它才能接入，故回执直接带回凭据包。
  credential_bundle: GatewayCredentialBundle
}

// 网关容器安装发起命令：客户服务工程师在客户现场启动网关容器时发出，驱动
// GatewayOnboardingFlow 的 InstallGatewayContainer step。
message<command> GatewayContainerInstallRequested {
  gateway_id: String
  instance_id: String
  requested_at: DateTime
}

message<response> GatewayInstallReceipt {
  gateway_id: String
  status: String
  received_at: DateTime
}

// 网关镜像下载发起命令：客户服务工程师在客户现场拉取网关镜像（docker pull）时发出，驱动
// GatewayOnboardingFlow 的 DownloadGatewayImage step。
message<command> GatewayImageDownloadRequested {
  gateway_id: String
  instance_id: String
  requested_at: DateTime
}

message<response> GatewayImageDownloadReceipt {
  gateway_id: String
  status: String
  received_at: DateTime
}

message<command> RegisterGateway {
  enrollment_token: String
  instance_id: String
  // 网关**对外基址**（对外域名）。注册即带上，中心可第一时间记下它；可选（老 gwlinkd 不带）。
  public_base_url: String?
  /// 网关侧生成的证书签名请求（CSR，PEM）：公钥在其中，私钥永不出网关。
  certificate_signing_request: String
  requested_at: DateTime
}

message<command> VerifyGatewayCredential {
  gateway_id: String
  certificate_serial: String
}

message<command> RenewGatewayCredential {
  gateway_id: String
  current_certificate_serial: String
  /// 网关为新证书生成的 CSR（轮换：用旧证书证明身份）。
  certificate_signing_request: String
  requested_at: DateTime
}

flow RegisterGatewayFlow {
  meta {
    label zh "网关注册管理中心"
    label en "Gateway Registration Flow"
    summary zh "WistGateway 持 REGIST_TOKEN 注册：消费注册凭据、防重复、用 CSR 签发网关专属客户端证书（mTLS 长期身份），返回注册回执。"
    tags "gateway", "registration", "enrollment", "secure"
  }

  actor WistGateway

  lane WistCenter for Control.InsightCenterApp.WistCenter

  creates GatewayEnrollmentTokenValidation
  creates GatewayIdentity
  creates GatewayClientCertificate
  creates GatewayCredentialBundle
  creates GatewayEnrollmentResult

  // 入口：WistGateway 持 REGIST_TOKEN 提交注册（by 声明 trigger，省略 flow-level trigger）。
  step SubmitRegistration in WistGateway by RegisterGateway {
    next ValidateEnrollmentToken
  }

  // 注册校验必须绑定 token 实例归属：按 token_id 命中 GatewayEnrollmentToken，校验其 gateway_id /
  // instance_id 与请求方一致，且未超期、未耗尽（used_count < max_uses），通过后才进入签发。
  step ValidateEnrollmentToken in WistCenter {
    create GatewayEnrollmentTokenValidation {
      token_id = RegisterGateway.enrollment_token
      gateway_id = "gateway-issued"
      status = "valid"
      validated_at = RegisterGateway.requested_at
    }
    next CheckDuplicateRegistration
  }

  // 防重复注册：同 gateway_id + instance_id 已注册则拒绝（GatewayIdentity 唯一 gateway_id）。
  step CheckDuplicateRegistration in WistCenter {
    next IssueGatewayIdentity
  }

  step IssueGatewayIdentity in WistCenter {
    create GatewayIdentity {
      gateway_id = "gateway-issued"
      instance_id = RegisterGateway.instance_id
      status = "Active"
      issued_at = RegisterGateway.requested_at
    }
    next IssueClientCertificate
  }

  // 用 CA-G 签一张网关专属客户端证书（subject = gateway_id），再把证书包进长期凭据。
  step IssueClientCertificate in WistCenter {
    create GatewayClientCertificate {
      certificate_id = "cert-issued"
      gateway_id = "gateway-issued"
      serial = "cert-serial-issued"
      certificate = "gateway-client-certificate-pem"
      issued_at = RegisterGateway.requested_at
      not_after = "2026-11-16T00:00:00Z"
      status = "Active"
    }
    create GatewayCredentialBundle {
      credential_id = "credential-issued"
      gateway_id = "gateway-issued"
      instance_id = RegisterGateway.instance_id
      certificate = "gateway-client-certificate-pem"
      issued_at = RegisterGateway.requested_at
      not_after = "2026-11-16T00:00:00Z"
    }
    next AcceptRegistration
  }

  step<stop> AcceptRegistration in WistCenter {
    create GatewayEnrollmentResult {
      status = "accepted"
      gateway_id = "gateway-issued"
      instance_id = RegisterGateway.instance_id
      credential_id = "credential-issued"
      initial_config = "v1"
    }
  }
}

flow VerifyGatewayCredentialFlow {
  meta {
    label zh "校验网关通讯凭据"
    label en "Verify Gateway Credential Flow"
    summary zh "WistGateway 访问网关接口前校验客户端证书的有效性（mTLS）。"
    tags "gateway", "credential", "verify"
  }

  actor WistGateway
  trigger VerifyGatewayCredential

  creates GatewayCredentialVerificationResult

  step<stop> VerifyCredential {
    create GatewayCredentialVerificationResult {
      gateway_id = VerifyGatewayCredential.gateway_id
      certificate_serial = VerifyGatewayCredential.certificate_serial
      status = "valid"
      verified_at = "now"
    }
  }
}

flow RenewGatewayCredentialFlow {
  meta {
    label zh "轮换网关客户端证书"
    label en "Rotate Gateway Client Certificate"
    summary zh "WistGateway 以当前客户端证书证明身份、提交新 CSR，换发一张新客户端证书（到期前轮换）；旧证书作废。"
    tags "gateway", "credential", "renewal", "certificate"
  }

  actor WistGateway

  lane WistCenter for Control.InsightCenterApp.WistCenter

  creates GatewayClientCertificate
  creates GatewayCredentialBundle

  // 入口：WistGateway 持当前证书（mTLS）申请轮换（by 声明 trigger）。
  step RequestRenewal in WistGateway by RenewGatewayCredential {
    next IssueRenewedCertificate
  }

  // 中心以当前证书鉴权后，用 CA-G 按新 CSR 签一张新证书；旧证书作废。
  step<stop> IssueRenewedCertificate in WistCenter {
    create GatewayClientCertificate {
      certificate_id = "cert-renewed"
      gateway_id = RenewGatewayCredential.gateway_id
      serial = "cert-serial-renewed"
      certificate = "gateway-client-certificate-renewed-pem"
      issued_at = "now"
      not_after = "2026-12-16T00:00:00Z"
      status = "Active"
    }
    create GatewayCredentialBundle {
      credential_id = "credential-renewed"
      gateway_id = RenewGatewayCredential.gateway_id
      certificate = "gateway-client-certificate-renewed-pem"
      issued_at = "now"
      not_after = "2026-12-16T00:00:00Z"
    }
  }
}

verify GatewayRegistrationVerified for flow RegisterGatewayFlow {
  given {
    // 与 GatewayOnboardingFlow.CallInitUrl 签发的 enrollment token_id 对齐，贯通「签发→注册消费」。
    RegisterGateway.enrollment_token = "enroll-regist-001"
    RegisterGateway.instance_id = "gateway-issued"
    RegisterGateway.requested_at = "2026-07-04T00:00:00Z"
  }

  when RegisterGateway

  expect {
    GatewayEnrollmentTokenValidation.status == "valid"
    GatewayCredentialBundle.credential_id == "credential-issued"
    GatewayClientCertificate.gateway_id == "gateway-issued"
    GatewayEnrollmentResult.status == "accepted"
    // R1：注册身份绑定到请求方实例，防重复/冒名注册。
    GatewayIdentity.instance_id == "gateway-issued"
    GatewayIdentity.status == "Active"
  }
}
