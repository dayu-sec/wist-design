// Module: GatewaySecurity — 网关安全凭据与信任材料（实体）
// 承载 WistGateway 接入安全机制的凭据/信任实体：接入券、注册 Token、
// 运行期凭据、控制中心信任包与校验记录。flows 由 GatewaySupervision 等承载。

struct ControlCenterTrustBundle {
  meta {
    label zh "控制中心信任包"
    label en "Control Center Trust Bundle"
    summary zh "WistGateway 校验 WistCenter HTTPS 服务端证书的 CA 信任材料（control-center.pem 公钥）与端点约束。"
    tags "gateway", "tls", "trust-bundle"
  }

  unique trust_bundle_id: String
  control_endpoint: String
  /// control-center.pem 公钥内容——最终交给 gateway 用于校验中心 TLS。
  ca_bundle: String
  server_name: String
  expected_san: String
  issued_at: DateTime?
  expires_at: DateTime?
}

struct GatewayEnrollmentToken {
  meta {
    label zh "网关注册 Token（RegistToken 存储记录）"
    label en "Gateway Enrollment Token"
    summary zh "网关注册凭据（RegistToken）的服务端存储记录：网关 init 置备时由中心签发，仅保存 token hash；绑定签发时的 gateway_id / instance_id，注册时校验与请求方一致；通过使用次数、有效期与状态控制合法性；随 token 携带控制中心签发的 TLS 信任根，供网关在注册前验证控制中心。明文签发值写入 config.toml [enrollment] token，本实体是其落库校验记录。"
    tags "gateway", "enrollment", "token", "storage"
  }

  unique token_id: String
  gateway_id: String
  instance_id: String?
  token_hash: String
  tenant_id: String
  environment_id: String
  control_center_trust_bundle: ControlCenterTrustBundle
  max_uses: Int
  used_count: Int
  issued_by: String
  issued_at: DateTime
  expires_at: DateTime
  revoked_at: DateTime
  status: GatewayEnrollmentTokenStatus
}

variant GatewayEnrollmentTokenStatus {
  meta {
    label zh "网关注册 Token 状态"
    label en "Gateway Enrollment Token Status"
    summary zh "描述网关注册 token 的可用、过期、耗尽或禁用等状态。"
    tags "gateway", "enrollment", "status"
  }

  Active
  Expired
  Revoked
  Used
  Exhausted
}

struct GatewayEnrollmentAuthProfile {
  meta {
    label zh "网关注册认证配置"
    label en "Gateway Enrollment Auth Profile"
    summary zh "定义 WistGateway 注册阶段所需的 HTTPS 服务端证书校验、内部 CA 信任根和注册 token 要求。"
    tags "gateway", "enrollment", "auth"
  }

  server_tls_required: Bool
  trust_bundle_required: Bool
  enrollment_token_required: Bool
}

struct GatewayEnrollmentTokenValidation {
  meta {
    label zh "网关注册 Token 校验"
    label en "Gateway Enrollment Token Validation"
    summary zh "WistGateway 注册时对预共享 token 的校验结果记录。"
    tags "gateway", "enrollment", "validation"
  }

  token_id: String
  gateway_id: String
  status: String
  validated_at: DateTime
}

struct GatewayLinkToken {
  meta {
    label zh "网关接入券"
    label en "Gateway Link Token"
    summary zh "WistCenter「生成/轮换」端点签发的一次性接入券：网关首跑调 link-upstream 时以 Bearer 出示；中心只存 sha256 + 短 TTL（默认 15 分钟），明文仅「连接 Gateway」页一次性展示、不进 create 响应；过期或再取即轮换（旧券作废）。"
    tags "gateway", "link", "token"
  }

  unique token_id: String
  gateway_id: String
  instance_id: String?
  token_hash: String
  status: GatewayLinkTokenStatus
  issued_at: DateTime
  expires_at: DateTime
  max_uses: Int
  used_count: Int
}

variant GatewayLinkTokenStatus {
  meta {
    label zh "接入券状态"
    label en "Gateway Link Token Status"
    summary zh "描述网关接入券的可用、已消费、过期或禁用状态。"
    tags "gateway", "link", "status"
  }

  Active
  Consumed
  Expired
  Revoked
}

struct GatewayCredentialBundle {
  meta {
    label zh "网关通讯凭据"
    label en "Gateway Credential Bundle"
    summary zh "WistGateway 注册成功后签发的长期身份：不再是对称 bearer，而是网关专属的客户端证书（mTLS）——每网关一张、私钥永不出网关、可单点吊销。"
    tags "gateway", "credential"
  }

  unique credential_id: String
  gateway_id: String
  instance_id: String?
  /// 客户端证书（PEM）。mTLS 是唯一凭据路径（bearer / auth_scheme 已删），必填。
  certificate: String
  ca_bundle: String?
  issued_at: DateTime
  not_before: DateTime?
  not_after: DateTime?
}

struct GatewayClientCertificate {
  meta {
    label zh "网关客户端证书"
    label en "Gateway Client Certificate"
    summary zh "由网关专属 CA（CA-G，与中心服务器证书的 CA 单开）签发、每台网关一张的客户端证书：绑定 gateway_id，用于对中心做 mTLS；私钥在网关侧生成、永不出网关；可轮换、可单点吊销。"
    tags "gateway", "certificate", "mtls", "identity"
  }

  unique certificate_id: String
  gateway_id: String
  serial: String
  /// 客户端证书（PEM）。
  certificate: String
  ca_bundle: String?
  issued_at: DateTime
  not_before: DateTime?
  not_after: DateTime?
  status: GatewayClientCertificateStatus
}

variant GatewayClientCertificateStatus {
  meta {
    label zh "网关客户端证书状态"
    label en "Gateway Client Certificate Status"
    summary zh "描述网关客户端证书的可用、已过期或已吊销状态。"
    tags "gateway", "certificate", "status"
  }

  Active
  Expired
  Revoked
}

struct GatewayCredentialVerificationResult {
  meta {
    label zh "网关凭据校验结果"
    label en "Gateway Credential Verification Result"
    summary zh "WistGateway 后续调用时客户端证书的校验结果记录。"
    tags "gateway", "credential", "verify"
  }

  gateway_id: String
  certificate_serial: String
  status: String
  verified_at: DateTime
}
