// Module: UserFacingInterface — 用户侧服务接口

message<command> AdminGetAgentInstallCode {
}

message<command> AdminShowAgentRuntimeStatus = OperatorRequest {
  agent_id: String
}

message<command> AdminGetAgentOverview = OperatorRequest {
}

message<command> AdminViewGatewayManagementState = OperatorRequest {
}

message<command> AdminLookupAgentRegistryEntry = OperatorRequest {
  agent_id: String
}

message<command> AdminQueryAgentCapabilityIndex = OperatorRequest {
  agent_id: String
}

// 管理面 Agent 列表：过滤 + 分页下推到存储层（对应 store 的 AgentQuery）。
// 出参是运行态的读投影，管理面额外的租户/环境/节点/凭据字段由实现层派生。
message<command> AdminListAgents = OperatorRequest {
  tenant_id: String?
  environment_id: String?
  status: String?
  limit: Int?
  offset: Int?
}

// 凋销指定 Agent 的指定凭据（凋销当前凭据后该 Agent 立即无法鉴权）。
message<command> AdminRevokeAgentCredential = OperatorRequest {
  agent_id: String
  credential_id: String
}

// 设置网关分发 wist-agentd 安装包所用的来源地址与校验摘要（管理面）。
message<command> AdminSetAgentInstallPackageAddress = OperatorRequest {
  package_url: String
  package_sha256: String?
}

// 查看当前生效的 wist-agentd 安装包地址（管理面）。
message<command> AdminViewAgentInstallPackageAddress = OperatorRequest {
}

// 查看当前生效的发现方向策略表（管理面）。
// 表是平台策展数据：运维要能看到“现在生效的是哪一版、各方向周期是多少”。
message<command> AdminViewDiscoveryPolicies = OperatorRequest {
}

// 查看某台 Agent 的用途：事实摘要、网关推断建议（含逐条依据）、人工判定三者并列。
// 推断可过期，判定留痕 —— 所以两者都回，不是只回一个“结论”。
message<command> AdminViewAgentPurpose = OperatorRequest {
  agent_id: String
}

// 归档某台 Agent 的用途判定（人工判定）：采纳某条建议，或直接改判 / 推翻建议。
// 采集范围是合规边界 —— 判定是按机器类别授权工作模板的前置，必须由人落这一笔。
// 分类必须与该机器平台一致（MacDaily/MacDev → macos，Linux* → linux），校验在实现层。
message<command> AdminClassifyAgent = OperatorRequest {
  agent_id: String
  machine_class: MachineClass
  // 采纳了哪条建议；人工直判/推翻建议时为空。
  suggestion_id: String?
  note: String?
}

// 查看某台 Agent 的软件清单（按机器看软件）：从事实摘要机械归并出的条目。
// 未知 agent 回 404；有 agent 但没上报过清单 = 200 + 空清单 + 计数 0。
message<command> AdminViewAgentSoftware = OperatorRequest {
  agent_id: String
}

// 按软件看机器：把机队里同一聚类键的持有情况聚合起来，受 limit 约束。
message<command> AdminViewSoftwareHoldings = OperatorRequest {
  limit: Int?
}

// 授权或更新某 Agent 的工作：
//   work_kind = Standing → 写期望版本（plan_version、spec），无自然结束；
//   work_kind = OneShot  → 提交一件有期限的活（scheduled_at / deadline_at / timeout_seconds）。
// kind 决定哪些可选字段必填，校验在实现层。
message<command> AdminGrantWork = OperatorRequest {
  agent_id: String
  work_kind: WorkKind
  // 常驻工作按**面**授权（work_kind = Standing 时必填）：一个面 = 一份工作。
  family: CollectionFamily?
  // 一次性工作按**动作**授权（work_kind = OneShot 时必填）。
  action: String?
  spec: String
  plan_version: Int?
  scheduled_at: DateTime?
  deadline_at: DateTime?
  timeout_seconds: Int?
}

// 撤回某 Agent 的一份工作：常驻工作撤销授权，一次性工作取消未了结的活。
message<command> AdminRevokeWork = OperatorRequest {
  agent_id: String
  work_id: String
  reason_code: String
}

// 提出采集内容变更提案。
//
// 现状：提出方也是人（亦可直接在 AdminGrantWork 里直填 spec）。
// 将来：由反馈统计（miss/residue/error）产出“建议”，但路径不变 —— 仍必须经 AdminReviewWork 审定。
message<command> AdminProposeWork = OperatorRequest {
  agent_id: String
  work_id: String?
  family: CollectionFamily
  mode: String
  catalog_version: Int
  facts_used: List<SelectionFact>
  selected_units: List<String>
  proposed_spec: String
}

// 审定提案：approved 后才能凭 proposal_id 授权生效（rejected 则留下驳回留痕）。
message<command> AdminReviewWork = OperatorRequest {
  proposal_id: String
  decision: String
  review_note: String?
}

// 暂停工作：work_id 为空 = 暂停该 Agent 的全部工作（维护/应急的一键停）。
// 常驻：保留授权与版本，恢复后继续用同一版本；Agent 重启后仍然是暂停。
// 一次性：只有 interruptible 的动作允许 running 期间暂停，否则应拒绝；
// 暂停期间不消耗执行预算（timeout_seconds），但照走绝对截止（deadline_at）。
message<command> AdminPauseWork = OperatorRequest {
  agent_id: String
  work_id: String?
  reason_code: String
}

// 继续工作：把 paused 改回进行态（常驻 active / 一次性 running）；
// 对已撤回/已替换/已终结的工作无效（恢复不绕过审定，也不复活已结束的活）。
message<command> AdminResumeWork = OperatorRequest {
  agent_id: String
  work_id: String?
  reason_code: String
}

interface WistGatewayPublicInstallInterface {
  meta {
    label zh "WistGateway 运维安装接口"
    label en "WistGateway Operations Install Interface"
    summary zh "运维/客户服务工程师通过管理员 bearer 身份获取 Agent 安装代码、发起网关容器安装；接口只负责安装脚本复制与容器引导，不面向未认证访问者开放。"
    tags "authenticated", "bootstrap", "agent-install", "gateway-install", "web", "interface"
  }

  entry AdminGetAgentInstallCode {
    actor OperationsEngineer
    output AgentInstallCode
  }

  entry GatewayContainerInstallRequested {
    actor CustomerServiceEngineer
    output GatewayInstallReceipt
  }

  entry GatewayImageDownloadRequested {
    actor CustomerServiceEngineer
    output GatewayImageDownloadReceipt
  }

  entry InitializeGatewayViaUrl {
    actor CustomerServiceEngineer
    output GatewayInitialConfig
    calls InitializeGatewayViaUrlFlow
  }
}

interface WistGatewayManagementInterface {
  meta {
    label zh "WistGateway 管理接口"
    label en "WistGateway Management Interface"
    tags "admin", "authenticated", "web", "interface"
  }

  entry AdminShowAgentRuntimeStatus {
    actor AdminOperator
    output AgentRuntimeStatus
  }

  entry AdminGetAgentOverview {
    actor AdminOperator
    output AgentOverview
  }

  entry AdminViewGatewayManagementState {
    actor AdminOperator
    output GatewayManagementState
  }

  entry AdminLookupAgentRegistryEntry {
    actor AdminOperator
    output AgentRegistryEntry
  }

  entry AdminQueryAgentCapabilityIndex {
    actor AdminOperator
    output AgentCapabilityIndex
  }

  entry DispatchAgentFleetCommand {
    actor AdminOperator
    output AgentFleetDispatchReceipt
  }

  entry AdminListAgents {
    actor AdminOperator
    output Projection<List<AgentRuntimeStatus>>
  }

  entry AdminRevokeAgentCredential {
    actor AdminOperator
    output AgentCredentialRevocationResult
  }

  entry AdminSetAgentInstallPackageAddress {
    actor PlatformMaintenanceEngineer
    output AgentInstallPackageAddress
  }

  entry AdminViewAgentInstallPackageAddress {
    actor OperationsEngineer
    output AgentInstallPackageAddress
  }

  entry AdminGrantWork {
    actor AdminOperator
    output WorkReceipt
  }

  entry AdminRevokeWork {
    actor AdminOperator
    output WorkReceipt
  }

  entry AdminProposeWork {
    actor AdminOperator
    output WorkProposal
  }

  entry AdminReviewWork {
    actor AdminOperator
    output WorkProposal
  }

  entry AdminPauseWork {
    actor AdminOperator
    output WorkReceipt
  }

  entry AdminResumeWork {
    actor AdminOperator
    output WorkReceipt
  }

  entry AdminViewAgentPurpose {
    actor AdminOperator
    output AgentPurposeView
  }

  entry AdminClassifyAgent {
    actor AdminOperator
    output AgentClassification
  }

  entry AdminViewAgentSoftware {
    actor AdminOperator
    output AgentSoftwareInventory
  }

  entry AdminViewSoftwareHoldings {
    actor AdminOperator
    output SoftwareHoldings
  }

  entry AdminViewDiscoveryPolicies {
    actor AdminOperator
    output DiscoveryPolicyView
  }
}

flow AdminGetAgentInstallCodeFlow {
  meta {
    label zh "获取 Agent 安装代码"
    label en "Get Agent Install Code Flow"
    summary zh "已认证的运维工程师获取可复制执行的 Agent 安装代码；管理端同时生成短期一次性 enrollment token，并在安装脚本中绑定包摘要和初始配置获取资格。"
    tags "admin", "agent-install", "authenticated"
  }

  actor OperationsEngineer
  trigger AdminGetAgentInstallCode

  // 取包来源来自管理面设置；分发地址恒为网关自身端点，制品由网关先拉到本地缓存
  // （未设置来源时用网关内置包）。
  depends AgentInstallPackageAddress

  creates AgentBootstrapBundle
  creates AgentEnrollmentToken
  creates AgentInstallCode

  step IssueEnrollmentToken {
    create AgentEnrollmentToken {
      token_id = "install-token-001"
      token_hash = "sha256:token-hash"
      tenant_id = "tenant-default"
      environment_id = "env-default"
      max_uses = 1
      used_count = 0
      issued_by = "operations-engineer"
      issued_at = "2026-07-04T00:00:00Z"
      expires_at = "2026-07-04T00:15:00Z"
      status = "active"
    }
    next BuildInstallCode
  }

  step<stop> BuildInstallCode {
    create AgentBootstrapBundle {
      bundle_id = "agent-bootstrap-install-token-001"
      install_script_url = "https://warp-gateway/api/v1/agent/install/x86/install.sh?token=install-token-001"
      // 分发地址恒为网关自身端点：目标主机不直连来源，只从网关取包；
      // 摘要与网关本地那份制品同源（来源由 AgentInstallPackageAddress 给出，
      // 未设置时是配置内置包）。具体取值由实现层派生。
      agent_package_url = "https://warp-gateway/api/v1/agent/packages/current"
      agent_package_sha256 = "sha256:package-digest"
      control_endpoint = "https://warp-gateway"
      trust_bundle = "internal-ca"
      tenant_id = "tenant-default"
      environment_id = "env-default"
      expires_at = "2026-07-04T00:15:00Z"
    }

    create AgentInstallCode {
      x86_linux_install_code = "curl -fsSL https://warp-gateway/api/v1/agent/install/x86/install.sh?token=install-token-001 | bash"
      arm_linux_install_code = "curl -fsSL https://warp-gateway/api/v1/agent/install/arm/install.sh?token=install-token-001 | bash"
      bootstrap_bundle = "agent-bootstrap-install-token-001"
    }
  }
}

flow AdminShowAgentRuntimeStatusFlow {
  meta {
    label zh "展示 Agent 运行状态"
    label en "Show Agent Runtime Status Flow"
    summary zh "管理员查询指定 Agent 的运行状态，并聚合生成管理端展示所需的运行状态视图。"
    tags "admin", "agent-status", "runtime-view"
  }

  actor AdminOperator
  trigger AdminShowAgentRuntimeStatus

  depends AgentInstance, AgentRuntimeStatus

  step<stop> BuildRuntimeStatusView {
    create AgentRuntimeStatus {
      agent_id = AdminShowAgentRuntimeStatus.agent_id
      status = "online"
    }
  }
}

flow AdminGetAgentOverviewFlow {
  meta {
    label zh "获取 Agent 总览"
    label en "Get Agent Overview Flow"
    summary zh "管理员打开 WistGateway 首页时，聚合 Agent 状态指标、最近上线注册 Agent 和异常 Agent 列表。"
    tags "admin", "agent-status", "overview", "homepage"
  }

  actor AdminOperator
  trigger AdminGetAgentOverview

  depends AgentInstance, AgentRuntimeStatus

  creates AgentOverviewMetrics
  creates RecentOnlineRegisteredAgent
  creates AgentOverview

  step<stop> BuildAgentOverview {
    create AgentOverviewMetrics {
      total_agents = 9
      online_agents = 7
      unhealthy_agents = 2
      last_seen_lag_seconds = 42
    }

    create RecentOnlineRegisteredAgent {
      agent_id = "agent-recent-001"
      instance_id = "agent-recent-001/boot-20260728"
      version = "0.1.0"
      registered_at = "2026-07-28T08:00:00Z"
      online_since = "2026-07-28T08:05:00Z"
      online_duration_seconds = 5400
    }

    create AgentOverview {
      metrics = AgentOverviewMetrics
      recent_online_agents = RecentOnlineRegisteredAgent
      abnormal_agents = AgentRuntimeStatus
    }
  }
}

flow AdminGrantWorkFlow {
  meta {
    label zh "授权 Agent 工作"
    label en "Grant Agent Work Flow"
    summary zh "管理员授权或更新某 Agent 的工作（常驻写期望版本，一次性提交有期限的活），生成工作回执。"
    tags "admin", "agent-work", "grant"
  }

  actor AdminOperator
  trigger AdminGrantWork
}

flow AdminRevokeWorkFlow {
  meta {
    label zh "撤回 Agent 工作"
    label en "Revoke Agent Work Flow"
    summary zh "管理员撤回某 Agent 的一份工作（常驻撤销授权，一次性取消未了结的活），生成工作回执。"
    tags "admin", "agent-work", "revoke"
  }

  actor AdminOperator
  trigger AdminRevokeWork
}

flow AdminProposeWorkFlow {
  meta {
    label zh "提出工作提案"
    label en "Propose Agent Work Flow"
    summary zh "提出采集内容变更提案（含选中依据），等待人工审定。"
    tags "admin", "agent-work", "proposal"
  }

  actor AdminOperator
  trigger AdminProposeWork
}

flow AdminReviewWorkFlow {
  meta {
    label zh "审定工作提案"
    label en "Review Agent Work Flow"
    summary zh "人工审定采集内容变更提案：采集范围即合规边界，批准后凭 proposal_id 授权才生效。"
    tags "admin", "agent-work", "review"
  }

  actor AdminOperator
  trigger AdminReviewWork
}

flow AdminPauseWorkFlow {
  meta {
    label zh "暂停 Agent 工作"
    label en "Pause Agent Work Flow"
    summary zh "管理员暂停某 Agent 的一份或全部常驻工作（维护/应急）；保留授权与版本，可继续恢复。"
    tags "admin", "agent-work", "pause"
  }

  actor AdminOperator
  trigger AdminPauseWork
}

flow AdminResumeWorkFlow {
  meta {
    label zh "继续 Agent 工作"
    label en "Resume Agent Work Flow"
    summary zh "管理员继续某 Agent 被暂停的工作：仍用暂停前的同一版本。"
    tags "admin", "agent-work", "resume"
  }

  actor AdminOperator
  trigger AdminResumeWork
}

flow AdminClassifyAgentFlow {
  meta {
    label zh "归档 Agent 用途判定"
    label en "Classify Agent Flow"
    summary zh "管理员把某台 Agent 的用途判定归档（采纳建议或人工改判）；分类必须与机器平台一致，落 AgentClassification 并留判定人与时间。"
    tags "admin", "purpose", "classification"
  }

  actor AdminOperator
  trigger AdminClassifyAgent
}

flow AdminViewGatewayManagementStateFlow {
  meta {
    label zh "查看网关管理状态"
    label en "View Gateway Management State Flow"
    summary zh "管理员查看 WistGateway 控制平台自身的实例、控制面配置与健康状态聚合视图。"
    tags "admin", "gateway", "management"
  }

  actor AdminOperator
  trigger AdminViewGatewayManagementState

  depends WistGatewayInstance, GatewayControlConfig, GatewayHealth

  creates GatewayManagementState

  step<stop> BuildManagementState {
    create GatewayManagementState {
      gateway_id = "gateway-001"
      instance_id = "gateway-001/boot-20260801"
      version = "0.1.0"
      status = "online"
      config = GatewayControlConfig
      health = GatewayHealth
      last_seen_at = "now"
    }
  }
}

flow AdminLookupAgentRegistryEntryFlow {
  meta {
    label zh "查询 Agent 登记记录"
    label en "Lookup Agent AgentRegistry Entry Flow"
    summary zh "管理员按 agent_id 查询 Agent 登记记录。"
    tags "admin", "agentd", "registry"
  }

  actor AdminOperator
  trigger AdminLookupAgentRegistryEntry

  creates AgentRegistryEntry

  step<stop> LookupEntry {
    create AgentRegistryEntry {
      agent_id = AdminLookupAgentRegistryEntry.agent_id
      tenant_id = "tenant-default"
      environment_id = "env-default"
      node_id = "node-default"
      current_instance_id = "instance-default"
      registered_at = "2026-08-01T00:00:00Z"
      updated_at = "now"
    }
  }
}

flow AdminQueryAgentCapabilityIndexFlow {
  meta {
    label zh "查询 Agent 能力索引"
    label en "Query Agent Capability Index Flow"
    summary zh "管理员按 agent 查询能力索引。"
    tags "admin", "agentd", "registry"
  }

  actor AdminOperator
  trigger AdminQueryAgentCapabilityIndex

  creates AgentCapabilityIndex

  step<stop> LookupIndex {
    create AgentCapabilityIndex {
      agent_id = AdminQueryAgentCapabilityIndex.agent_id
      instance_id = "instance-default"
      capability_report_id = "cap-report-001"
      generated_at = "2026-08-01T00:00:00Z"
      indexed_at = "now"
    }
  }
}

verify AdminGetAgentInstallCodeVerified for flow AdminGetAgentInstallCodeFlow {
  given {
  }

  when AdminGetAgentInstallCode

  expect {
    AgentEnrollmentToken.max_uses == 1
    AgentBootstrapBundle.bundle_id == "agent-bootstrap-install-token-001"
    AgentInstallCode.bootstrap_bundle == "agent-bootstrap-install-token-001"
  }
}

verify AdminGetAgentOverviewVerified for flow AdminGetAgentOverviewFlow {
  given {
    AdminGetAgentOverview.requested_by = "admin-operator"
  }

  when AdminGetAgentOverview

  expect {
    AgentOverviewMetrics.total_agents == 9
    AgentOverviewMetrics.online_agents == 7
    AgentOverviewMetrics.unhealthy_agents == 2
    RecentOnlineRegisteredAgent.online_duration_seconds == 5400
    AgentOverview.recent_online_agents == RecentOnlineRegisteredAgent
    AgentOverview.abnormal_agents == AgentRuntimeStatus
  }
}
