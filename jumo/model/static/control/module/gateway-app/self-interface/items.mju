// Module: SelfInterface — 网关自述接口（环回；供 host 侧 wist-gwlinkd 拉取）
//
// 刻意**未 `bind`**：本端点只绑环回、面向本机常驻，其鉴权尚未定案；现在写 `auth none`
// 会把「目标形态」记成「无鉴权」，反而是假的 —— 与网关 ingest 内部监听的既有处理同口径
// （见 WistAgentdOnlineRegistrationInterface 内注释）。待鉴权定案后再补 bind，届时 codegen 可生成路由。

message<query> QuerySelfState {
  gateway_id: String
}

struct GatewaySelfState {
  meta {
    label zh "网关自述状态"
    label en "Gateway Self State"
    summary zh "网关进程内可算准的自身状态快照：供 host 侧 wist-gwlinkd 上报中心与判定生死。"
    tags "gateway", "self", "status"
  }

  gateway_id: String
  version: String
  collected_at: DateTime
  // 存储健康：能否查询（判据在网关侧）
  store_healthy: Bool
  // 已登记 Agent 数（机队规模）
  agent_count: Int
  // 数据面上送是否启用（无目标 = 不采集、不上送）
  uplink_enabled: Bool
  last_error: String?
  // 网关**进程**已运行秒数。
  uptime_seconds: Int
  // 网关**进程** CPU 占比（单核口径，100% = 占满一核，可能 >100）；量不出时为 null。
  cpu_percent: Float?
  // 网关**进程**常驻内存（字节，RSS）；量不出时为 null。
  memory_bytes: Int?
  // 已登记 Agent 中**在线**的台数（last_seen 在窗口内）。
  online_agents: Int
  // 已登记但**离线**的台数（= agent_count − online_agents）。
  offline_agents: Int
  // 机队里最久没上报的那台的滞后秒数（0 = 都新鲜）。
  last_seen_lag_seconds: Int
  // 存储大小（字节；SQLite 文件大小，读不到 / 内存库为 0）。
  store_bytes: Int
  // 累计接收 / 拒收的数据面事实条数（自进程启动）。
  ingest_accepted_total: Int
  ingest_rejected_total: Int
  // 最近一次接收事实的时刻（未接收过为 null）。
  last_ingest_at: DateTime?
  // 主机（网关所在机器）内存总量（字节）。
  memory_total_bytes: Int?
  // 主机 1 / 5 / 15 分钟负载。
  load_1m: Float?
  load_5m: Float?
  load_15m: Float?
  // 主盘使用率（0..100）与总量 / 可用（字节，汇总挂载点，近似）。
  disk_usage_percent: Float?
  disk_total_bytes: Int?
  disk_available_bytes: Int?
}

interface GatewaySelfInterface {
  meta {
    label zh "网关自述接口"
    label en "Gateway Self Interface"
    summary zh "本机 host 侧常驻拉取网关进程内状态的环回接口。"
    tags "gateway", "self", "probe", "http", "interface"
  }

  entry QuerySelfState {
    actor WistGateway
    output GatewaySelfState
  }
}
