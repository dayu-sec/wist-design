// Module: PlatformRelease — 平台版本发布
// 覆盖 WistAgentd / WistGateway 新版本的发布。

command PublishWistAgentd = OperatorRequest {
  meta {
    label zh "发布 WistAgentd"
    label en "Publish WistAgentd"
    tags "release", "wist-agentd"
  }

  version: String
  artifact_url: String
  requested_at: DateTime
}

struct WistAgentdRelease {
  meta {
    label zh "WistAgentd 发布记录"
    label en "WistAgentd Release"
    tags "release", "wist-agentd"
  }

  version: String
  artifact_url: String
  status: String
  published_at: DateTime
}

command PublishWistGateway = OperatorRequest {
  meta {
    label zh "发布 WistGateway"
    label en "Publish WistGateway"
    tags "release", "warp-gateway"
  }

  version: String
  artifact_url: String
  requested_at: DateTime
}

struct WistGatewayRelease {
  meta {
    label zh "WistGateway 发布记录"
    label en "WistGateway Release"
    tags "release", "warp-gateway"
  }

  version: String
  artifact_url: String
  status: String
  published_at: DateTime
}

// 制品存储后端：本地文件或云对象存储（S3 兼容 / MinIO）。
variant ArtifactStorageKind {
  meta {
    label zh "制品存储类型"
    label en "Artifact Storage Kind"
    tags "release", "artifact", "storage"
  }

  LocalFile
  ObjectStorage
}

// 制品镜像记录：发布时把外部制品（GitHub / 制品库，访问慢）下载后镜像到本地文件或
// 云对象存储，`stored_url` 为快的下载地址（供升级拉取），避免直接依赖慢源分发。
struct ArtifactMirror {
  meta {
    label zh "制品镜像记录"
    label en "Artifact Mirror"
    tags "release", "artifact", "mirror"
  }

  component: String
  version: String
  source_url: String
  stored_url: String
  storage_kind: ArtifactStorageKind
  mirrored_at: DateTime
}

// 升级计划本体不在这里建模：用通用的 `Control.Rollout.RolloutPlan`
// （phases 带 advance_rule / current_phase / 逐目标 RolloutPlanEntry）—— 中心与网关同一套，
// 中心铺的是网关（target = gateway_id）；创建入参也是同一份 `Control.CreateRolloutPlan`。
// 本模块只保留「升级」这个动作特有的**发布记录**与制品镜像（WistAgentdRelease /
// WistGatewayRelease / ArtifactMirror）—— 计划本体与创建/批准/推进/查看的入参都不在这里：
// 计划本体是 `Control.Rollout`，管理入参是 `Control.RolloutApp.AdminInterface`（中心与网关共享）。
