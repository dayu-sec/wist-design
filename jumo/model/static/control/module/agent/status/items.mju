// Module: AgentStatus — Agentd 状态管理

struct AgentInstance {
  meta {
    label zh "Agentd 实例"
    label en "Agentd Instance"
    summary zh "一次 Agentd 运行实例的状态记录，包含 boot id、版本、启动时间和最后在线时间。"
    tags "agentd", "status"
  }

  unique instance_id: String
  agent_id: String
  boot_id: String
  version: String
  started_at: DateTime
  last_seen_at: DateTime
}

command ShowAgentRuntimeStatus = OperatorRequest {
  agent_id: String
}

command GetAgentOverview = OperatorRequest {
}

struct AgentRuntimeStatus {
  meta {
    label zh "Agentd 运行状态视图"
    label en "Agentd Runtime Status View"
    summary zh "WistGateway 展示 Agentd 在线状态、版本、健康状态和最后上报时间所需的聚合视图。"
    tags "agentd", "status-view"
  }

  agent_id: String
  instance_id: String
  version: String
  status: String
  last_seen_at: DateTime
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  admin_latency_ms: Int?
  // 机器身份：中心页要能回答“这是哪台机器”。来自网关注册表的机器画像，
  // 旧版生产者不报时为 null（不是空串，也不是“没有机器”）。
  node_id: String?
  hostname: String?
  // 形如 `en0 192.168.1.5/24`；空表 = 还没报过 / 确实没有地址。
  ip_addresses: List<String>?
  // 数据清单：采集授权 + 调查数据（网关从工作授权、agentd 本机视图与调查报告派生）。
  // null = 旧版生产者不报 —— 中心页据此区分「还没上报」与「确实什么数据都没有」。
  data_manifest: AgentDataManifest?
}

// 数据清单里的一条采集来源。与 `wist_contracts::work::WorkSpecSource` 同源（kind + target），
// 但只带「采什么」，不带 multiline / filters 这类执行参数 —— 清单是数据目录，不是可重放的工作副本。
struct AgentDataSource {
  meta {
    label zh "采集来源"
    label en "Agent Data Source"
    summary zh "数据清单里的一条采集来源：来源类型与目标（文件路径 / exporter / 指标间隔 / auto）。"
    tags "control", "agentd", "data-manifest"
  }

  kind: String
  target: String
}

// 数据清单里的一条采集授权（一个采集面 = 一份常驻工作）。
// 期望侧来自网关的 StandingWork，实测侧来自 agentd 上报的 AgentLocalWork；缺就是 null。
struct AgentCollectionEntry {
  meta {
    label zh "采集授权条目"
    label en "Agent Collection Entry"
    summary zh "一条采集授权：采集面、授权状态、期望/已确认版本、agentd 实测结论与覆盖来源。"
    tags "control", "agentd", "data-manifest", "collection"
  }

  family: String
  work_id: String
  // active | paused（撤回与被取代的历史版本不进清单）。
  status: String
  plan_version: Int
  acknowledged_version: Int?
  // agentd 的实测采集结论：ok / degraded / failed / unknown / paused；null = 本机还没报过。
  collection_status: String?
  collection_detail: String?
  inputs: List<AgentDataSource>
}

// 数据清单里的一份调查数据（一条已落盘报告的摘要，正文不在这里）。
struct AgentInvestigationEntry {
  meta {
    label zh "调查数据条目"
    label en "Agent Investigation Entry"
    summary zh "一份调查报告的摘要：关联键、面、观测时刻、结论档、判定与四类计数（不含正文）。"
    tags "control", "agentd", "data-manifest", "investigation"
  }

  command_id: String
  topic: String
  observed_at: DateTime
  // ok | warn | fail；报告里没写就是 unknown。
  overall: String
  verdict: String
  findings_ok: Int
  findings_warn: Int
  findings_fail: Int
  // 无法判定（读不到 / 平台不支持 / 源不存在）。不能省：少了它，“没读到”会被当成“正常”。
  findings_unknown: Int
  judged: Boolean
}

// 一台 Agent 的数据清单：采集授权 + 调查数据。
// 两段都按清单口径裁剪，不带正文 —— 中心页回答「有什么数据」，不是「数据里写了什么」。
struct AgentDataManifest {
  meta {
    label zh "Agent 数据清单"
    label en "Agent Data Manifest"
    summary zh "一台 Agent 的数据清单：采集授权（面/版本/实测结论/来源）与调查数据（报告摘要）。"
    tags "control", "agentd", "data-manifest"
  }

  collected_at: DateTime
  collection: List<AgentCollectionEntry>
  investigations: List<AgentInvestigationEntry>
}

struct AgentOverviewMetrics {
  meta {
    label zh "Agent 总览指标"
    label en "Agent Overview Metrics"
    tags "agentd", "status", "overview", "metrics"
  }

  total_agents: Int
  online_agents: Int
  unhealthy_agents: Int
  last_seen_lag_seconds: Int
}

struct RecentOnlineRegisteredAgent {
  meta {
    label zh "最近上线注册 Agent"
    label en "Recent Online Registered Agent"
    summary zh "总览页“最近上线的 Agent”卡片：身份/版本/上线时长，加上**最近一次上报的运行态快照**（与 AgentRuntimeStatus 同源，只是随列表一起带出）。"
    tags "agentd", "status", "overview", "recent-online"
  }

  agent_id: String
  instance_id: String
  version: String
  registered_at: DateTime
  online_since: DateTime
  online_duration_seconds: Int
  // 真实注册还是空态演示数据：`example` 只在“一条真 Agent 都没有”时用来撑页面，
  // 必须能区分，否则演示数据会被读成真实资产。
  source: RecentOnlineRegisteredAgentSource
  memory_bytes: Int?
  // **单核口径**：100% = 占满一个核（多线程可 >100）。只统计 agent 进程**自己**的 CPU 时间，
  // 不含它拉起的子进程。
  cpu_percent: Float?
  // **整机口径**（0..100）= cpu_percent / cpu_cores。核数缺失或为 0 时为空 ——
  // “算不出来”不得写成 0，那会在页面上伪造出一段“整机空闲”的假读数。
  cpu_percent_of_machine: Float?
  cpu_cores: Int?
  admin_latency_ms: Int?
  // 尾部采样窗口（时序全量在 VictoriaMetrics，库里只留最近值）。
  metrics_history: List<AgentStatusMetricSample>
}

variant RecentOnlineRegisteredAgentSource {
  meta {
    label zh "最近上线 Agent 数据来源"
    label en "Recent Online Registered Agent Source"
    summary zh "real = 真实注册的 Agent；example = 没有真实 Agent 时用于空态演示的示例数据。"
    tags "agentd", "status", "overview"
  }

  Real
  Example
}

// 时序指标的一个采样点：`at` 为观测时刻，其余为当期读数（缺 = 该点没测到，不是 0）。
//
// 名字带 `Status`：它是**运行状态视图**的采样点（字符串时间戳、只含自身上报的几项），
// 与中心仓里那个同名的 VM 查询行（数值时间戳、全 `Float`）不是一回事，必须能分开。
struct AgentStatusMetricSample {
  meta {
    label zh "Agent 指标采样点"
    label en "Agent Metric Sample"
    tags "agentd", "status", "metrics"
  }

  at: DateTime
  memory_bytes: Int?
  cpu_percent: Float?
  cpu_percent_of_machine: Float?
  cpu_cores: Int?
  admin_latency_ms: Int?
}

struct AgentOverview {
  meta {
    label zh "Agent 总览"
    label en "Agent Overview"
    tags "agentd", "status", "overview", "admin-home"
  }

  metrics: AgentOverviewMetrics
  recent_online_agents: List<RecentOnlineRegisteredAgent>
  abnormal_agents: List<AgentRuntimeStatus>
}

// ── Agent 登记查询（AgentRegistryQuery 并入） ──

command LookupAgentRegistryEntry = OperatorRequest {
  meta {
    label zh "查询 Agent 登记记录"
    label en "Lookup Agent Registry Entry"
    tags "agentd", "registry", "lookup"
  }

  agent_id: String
}

command QueryAgentCapabilityIndex = OperatorRequest {
  meta {
    label zh "查询 Agent 能力索引"
    label en "Query Agent Capability Index"
    tags "agentd", "registry", "capability"
  }

  agent_id: String
}
