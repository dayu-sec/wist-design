// Module: AgentStatus — Agentd 状态管理

struct AgentInstance {
  meta {
    label zh "Agentd 实例"
    label en "Agentd Instance"
    summary zh "一次 Agentd 运行实例的状态记录，包含 boot id、版本、启动时间和最后在线时间。"
    tags "agentd", "status"
  }

  unique instance_id: String
  agent_id: String
  boot_id: String
  version: String
  started_at: DateTime
  last_seen_at: DateTime
}

command ShowAgentRuntimeStatus = OperatorRequest {
  agent_id: String
}

command GetAgentOverview = OperatorRequest {
}

struct AgentRuntimeStatus {
  meta {
    label zh "Agentd 运行状态视图"
    label en "Agentd Runtime Status View"
    summary zh "WistGateway 展示 Agentd 在线状态、版本、健康状态和最后上报时间所需的聚合视图。"
    tags "agentd", "status-view"
  }

  agent_id: String
  instance_id: String
  version: String
  status: String
  last_seen_at: DateTime
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  admin_latency_ms: Int?
}

struct AgentOverviewMetrics {
  meta {
    label zh "Agent 总览指标"
    label en "Agent Overview Metrics"
    tags "agentd", "status", "overview", "metrics"
  }

  total_agents: Int
  online_agents: Int
  unhealthy_agents: Int
  last_seen_lag_seconds: Int
}

struct RecentOnlineRegisteredAgent {
  meta {
    label zh "最近上线注册 Agent"
    label en "Recent Online Registered Agent"
    summary zh "总览页“最近上线的 Agent”卡片：身份/版本/上线时长，加上**最近一次上报的运行态快照**（与 AgentRuntimeStatus 同源，只是随列表一起带出）。"
    tags "agentd", "status", "overview", "recent-online"
  }

  agent_id: String
  instance_id: String
  version: String
  registered_at: DateTime
  online_since: DateTime
  online_duration_seconds: Int
  // 真实注册还是空态演示数据：`example` 只在“一条真 Agent 都没有”时用来撑页面，
  // 必须能区分，否则演示数据会被读成真实资产。
  source: RecentOnlineRegisteredAgentSource
  memory_bytes: Int?
  // **单核口径**：100% = 占满一个核（多线程可 >100）。只统计 agent 进程**自己**的 CPU 时间，
  // 不含它拉起的子进程。
  cpu_percent: Float?
  // **整机口径**（0..100）= cpu_percent / cpu_cores。核数缺失或为 0 时为空 ——
  // “算不出来”不得写成 0，那会在页面上伪造出一段“整机空闲”的假读数。
  cpu_percent_of_machine: Float?
  cpu_cores: Int?
  admin_latency_ms: Int?
  // 尾部采样窗口（时序全量在 VictoriaMetrics，库里只留最近值）。
  metrics_history: List<AgentStatusMetricSample>
}

variant RecentOnlineRegisteredAgentSource {
  meta {
    label zh "最近上线 Agent 数据来源"
    label en "Recent Online Registered Agent Source"
    summary zh "real = 真实注册的 Agent；example = 没有真实 Agent 时用于空态演示的示例数据。"
    tags "agentd", "status", "overview"
  }

  Real
  Example
}

// 时序指标的一个采样点：`at` 为观测时刻，其余为当期读数（缺 = 该点没测到，不是 0）。
//
// 名字带 `Status`：它是**运行状态视图**的采样点（字符串时间戳、只含自身上报的几项），
// 与中心仓里那个同名的 VM 查询行（数值时间戳、全 `Float`）不是一回事，必须能分开。
struct AgentStatusMetricSample {
  meta {
    label zh "Agent 指标采样点"
    label en "Agent Metric Sample"
    tags "agentd", "status", "metrics"
  }

  at: DateTime
  memory_bytes: Int?
  cpu_percent: Float?
  cpu_percent_of_machine: Float?
  cpu_cores: Int?
  admin_latency_ms: Int?
}

struct AgentOverview {
  meta {
    label zh "Agent 总览"
    label en "Agent Overview"
    tags "agentd", "status", "overview", "admin-home"
  }

  metrics: AgentOverviewMetrics
  recent_online_agents: List<RecentOnlineRegisteredAgent>
  abnormal_agents: List<AgentRuntimeStatus>
}

// ── Agent 登记查询（AgentRegistryQuery 并入） ──

command LookupAgentRegistryEntry = OperatorRequest {
  meta {
    label zh "查询 Agent 登记记录"
    label en "Lookup Agent Registry Entry"
    tags "agentd", "registry", "lookup"
  }

  agent_id: String
}

command QueryAgentCapabilityIndex = OperatorRequest {
  meta {
    label zh "查询 Agent 能力索引"
    label en "Query Agent Capability Index"
    tags "agentd", "registry", "capability"
  }

  agent_id: String
}
