// Module: Agent.Work — 网关派给 Agent 的工作
//
// 分界是声明式 / 命令式，不是“有没有结束”：
//   常驻工作 = 期望状态（无自然结束，只被新版本替换或被撤回，可自愈）；
//   一次性工作 = 命令式派发（有计划开始时间、期限与终态）。
//
// 暂停与继续：
//   常驻工作：
//   - 暂停 ≠ 撤回：暂停保留授权与 plan_version，恢复后继续用同一版本，不重新审定；
//     真正的“停止”是撤回，从撤回恢复要走新的提案 + 审定。
//   - 暂停是**期望状态的一部分**：Agent 处于暂停时“没在做”不算漂移（期望就是不做）。
//   - 暂停是持久的：Agent 重启或断网后重新拉快照仍是 paused，不会自己恢复采集。
//   - 与 Agent 本地的“暂停”分开：agentd 已有 `spool over limit; source read paused`
//     这类**本地保护**（自动、临时）；网关下发的暂停是**授权层的状态**，
//     两者在观测里必须能分辨（实现层靠 reason 区分），不要混成一个 paused。
//
//   一次性工作（长跑时同样要能暂停）：
//   - 可中断性：只有 `interruptible` 的动作才允许 running 期间暂停；不可中断的应**拒绝**，
//     而不是“尽力暂停”（挂起半个升级进程比不暂停更危险）。
//   - 时间语义：暂停期间**不消耗执行预算**（timeout_seconds），但**照走绝对截止**
//     （deadline_at）—— 两者任一先到即终结：预算尽 = timed_out，截止到 = expired。
//     **判定在网关侧**：到期与预算尽由网关的定时扫描收敛成终态，不依赖 agent 在线 ——
//     agent 掉线恰恰是这活最可能卡住的时候。agent 只报结果；「它没成」这个结论由网关落成终态。
//   - 恢复**从步级断点继续**（completed_steps 保留、current_step 重做），不整件重来；
//     执行载体 Reporting.ActionPlan 本来就是多步，StepActionRecord 已记每步结果，
//     不必另造进度概念。
//   - 恢复同样不改变工作内容与版本（与常驻工作同一条不变式）。
//
// 命名一致：网关**授权**（grant）工作、Agent 拉取**授权快照**（ WorkGrant ）、
// 管理面授权或撤回 —— 三个动作共用同一个词根，避免 Grant / Dispatch / Assign 混用。
//
// 状态字段用 String（与 AgentCommand 的 status 口径一致），取值见各字段注释。

variant WorkKind {
  meta {
    label zh "工作类型"
    label en "Work Kind"
    summary zh "常驻工作（持续到被替换或撤回）与一次性工作（有期限与终态）。"
    tags "agentd", "work"
  }

  Standing
  OneShot
}

struct StandingWork {
  meta {
    label zh "常驻工作"
    label en "Standing Work"
    summary zh "网关声明该 Agent 应当持续执行的工作：无自然结束，只被新版本替换或被撤回；断网或重启后以期望状态重新拉取即可恢复。"
    tags "agentd", "work", "standing"
  }

  unique work_id: String
  agent_id: String
  // 工作粒度 = **采集面**（CollectionFamily）：“一个面 = 一份常驻工作”。
  // 这样才做得到“按面暂停 / 限流 / 审计” —— 原先按 capability 授权，一份 collect_logs
  // 裹了十几个面，任何按面控制都无从下手；也让工作粒度与 SelectionBasis 的单元级审计对得上。
  family: CollectionFamily
  // 工作参数（清单/参数）。随 plan_version 整体替换，不做字段级增量合并。
  // 内容由采集目录的条目**物化**而成，不是自由文本：单元的采集来源（sources）与
  // 数据面规则标识（rule_ref）一并带上，agentd 拿到就能直接采，不必再去网关拉目录。
  // 编码：`{"units":[{unit_id, capability, rule_ref, requires_privilege, sources:[{kind,target}]}]}`。
  // **不携带 capability 作为工作级字段**：该面由哪个采集器承接，由 spec 里的单元各自决定。
  spec: String
  // 本工作按**哪一版目录**展开（物化溯源 + 版本锁）：目录换版**不追改**已授权工作，
  // 要让这台机器跟到新版，走新提案 + 审定（与 template_version 同一条不变式）。
  catalog_version: Int
  // 生效依据：指向已批准的提案（人工直填 spec 时为空）。采集范围变更必须留审。
  proposal_id: String?
  // 期望版本：网关每次改动 +1；Agent 上报实际版本，与它比对即得漂移。
  plan_version: Int
  effective_from: DateTime
  // active | paused | superseded | revoked
  status: String
  updated_by: String
  updated_at: DateTime
}

struct OneShotWork {
  meta {
    label zh "一次性工作"
    label en "One Shot Work"
    summary zh "网关派给该 Agent 的一次性工作：有计划开始时间与期限，有明确终态。"
    tags "agentd", "work", "one-shot"
  }

  unique work_id: String
  agent_id: String
  // 动作面：upgrade / snapshot / exec / ...（执行载体是 Reporting 域的 ActionPlan）
  action: String
  spec: String
  // 计划开始时间：到点前不应执行（与“立即派发”区分开）。
  scheduled_at: DateTime
  // 绝对截止：业务要求的时间点，**暂停也照走**（不由暂停顺延）。
  deadline_at: DateTime
  // 执行预算（秒）：**只在实际执行时消耗**，暂停期间不计。
  // 与 deadline_at 任一先到即终结：预算尽 = timed_out，截止到 = expired。
  timeout_seconds: Int
  // 可中断性：只有可中断的动作才允许 running 期间暂停。由动作目录/派发方声明。
  interruptible: Boolean
  // dispatched | accepted | running | paused | succeeded | failed | timed_out | canceled | expired
  status: String
  // 当前暂停的起点（运行中暂停才有；恢复后清空）。
  paused_at: DateTime?
  // 累计暂停时长（秒）：用于审计与“预算未被暂停消耗”的核对。
  paused_total_seconds: Int
  // 步级断点：已完成的步骤保留、current_step 在恢复时重做（执行载体是 ActionPlan）。
  current_step: String?
  completed_steps: List<String>
  // 已尝试次数（含恢复后的重做）。
  attempt: Int
  issued_by: String
  issued_at: DateTime
}

struct WorkGrant {
  meta {
    label zh "工作授权快照"
    label en "Work Grant"
    summary zh "网关授权给某 Agent 的工作集合：常驻工作的当前生效版本，加上未了结的一次性工作。幂等，可重复拉取。"
    tags "agentd", "work", "grant"
  }

  unique agent_id: String
  // 每个面一条（模板按 family_scope 展开成“一面一份工作”）。
  standing: List<StandingWork>
  one_shot: List<OneShotWork>
  // 授权序号：Agent 据此判断快照是否有变化（不承担“指令重放”的语义）。
  sequence: Int
  granted_at: DateTime
}

// 数据面上送的**当前期望状态**：由“该 Agent 有没有生效工作” + 上送目标
// （管理面设过的优先，否则按部署配置派生：与网关对外地址同域 + 数据面端口）现算出来，
// 不是存下来的配置。幂等、可重复拉取（与 WorkGrant 同类）。
//
// 为什么不并进 WorkGrant：那一份是 deny_unknown_fields 的字节，加字段会让
// “新网关 + 旧 agentd” 解析失败，旧 agentd 连工作授权都收不到。所以走独立路由
// （见 Control.AgentApp.FacingInterface 的 PollAgentUplink）。
//
// 授权优先于本机：enabled=false 是待命（不采、不上送日志/指标）；enabled=true 且给出目标时，
// 目标覆盖 Agent 本机 `[telemetry.logs.output]` 的 kind/addr —— 托管模式下目标由控制面说了算，
// 本机配置只作 standalone 的兜底。
//
// 注意：**事实摘要不受此开关管** —— 待命期仍上报进程列表等推断元数据（否则新装机器在网关侧
// 一片空白，连「该派什么活」都定不下来）。
struct AgentUplinkGrant {
  meta {
    label zh "数据面上送授权"
    label en "Agent Uplink Grant"
    summary zh "网关下发某 Agent 的数据面上送期望状态：是否启用，以及启用时要覆盖的本机目标；由工作授权现算，幂等。"
    tags "agentd", "work", "uplink"
  }

  // 与代码 `bool` 对齐。注：全库 `Bool` / `Boolean` 两种拼法混用，这里统一成 `Boolean`。
  enabled: Boolean
  // 数据面地址；enabled=true 时给出即覆盖 Agent 本机的 `telemetry.logs.output.tcp`。
  host: String?
  // 1..=65535（代码是 `u16` —— 模型只有 `Int`，窄化与无符号性靠这句说明）。
  port: Int?
  granted_at: DateTime
}

struct WorkReceipt {
  meta {
    label zh "工作回执"
    label en "Work Receipt"
    summary zh "管理面授权或撤回工作的回执：一份工作一次，含生效版本与结果状态。"
    tags "control", "work", "receipt"
  }

  unique work_id: String
  agent_id: String
  work_kind: WorkKind
  // accepted | paused | resumed | revoked | rejected
  status: String
  plan_version: Int
  created_at: DateTime
}

struct WorkAccepted {
  meta {
    label zh "工作已确认"
    label en "Work Accepted"
    summary zh "Agent 对某份工作的确认结果：accepted（版本对得上，收到了）/ stale（版本对不上，请重拉快照）/ unknown（网关不认识这份工作）。"
    tags "control", "work", "ack"
  }

  work_id: String
  // accepted | stale | unknown
  status: String
  accepted_at: DateTime
}

struct WorkResultAccepted {
  meta {
    label zh "工作结果已接收"
    label en "Work Result Accepted"
    summary zh "网关对 Agent 上报的执行结果的回应：accepted（已推进工作状态并留下结果记录）/ stale（这件活已了结：结果不覆盖终态但照存）/ unknown（不认识这件活或不属于它）。"
    tags "control", "work", "result"
  }

  work_id: String
  // accepted | stale | unknown
  status: String
  accepted_at: DateTime
}

event WorkGranted {
  meta {
    label zh "工作已授权"
    label en "Work Granted"
    summary zh "网关授权或更新了某 Agent 的一份工作。"
    tags "control", "work", "grant"
  }

  work_id: String
  agent_id: String
  work_kind: WorkKind
  plan_version: Int
  granted_at: DateTime
}

event WorkRevoked {
  meta {
    label zh "工作已撤回"
    label en "Work Revoked"
    summary zh "网关撤回了某 Agent 的一份工作（常驻：撤销授权；一次性：取消未了结的活）。"
    tags "control", "work", "revoke"
  }

  work_id: String
  agent_id: String
  reason_code: String
  revoked_at: DateTime
}

event WorkPaused {
  meta {
    label zh "工作已暂停"
    label en "Work Paused"
    summary zh "网关暂停了某 Agent 的一份或全部常驻工作：保留授权与版本，Agent 回到“暂不做但仍持有”。"
    tags "control", "work", "pause"
  }

  work_id: String
  agent_id: String
  reason_code: String
  paused_at: DateTime
}

event WorkResumed {
  meta {
    label zh "工作已继续"
    label en "Work Resumed"
    summary zh "网关继续了某 Agent 被暂停的工作：仍用暂停前的同一版本，不经过重新审定。"
    tags "control", "work", "resume"
  }

  work_id: String
  agent_id: String
  reason_code: String
  resumed_at: DateTime
}

// 工作内容的取值空间（采集面 / 采集单元 / 常驻工作模板 / 选中依据）见 Control.Agent.Content；
// 本文件只保留“工作”本身与内容变更提案。

// 采集内容变更提案：审定后才生效。
//
// 现在提出方也是人（人工直填 spec）；将来由反馈统计产出“建议”，
// 但**路径不变**：一律得人工审定后才成为 spec（采集范围就是合规边界）。
struct WorkProposal {
  meta {
    label zh "工作提案"
    label en "Work Proposal"
    summary zh "采集内容的变更提案：经人工审定（approved）后才能凭 proposal_id 授权生效。"
    tags "control", "work", "proposal"
  }

  unique proposal_id: String
  agent_id: String
  // 变更既有常驻工作时指向它；新建时为空。
  work_id: String?
  // 提案针对**哪个面**的内容（与工作同粒度：面）。
  family: CollectionFamily
  basis: SelectionBasis
  proposed_spec: String
  // proposed | approved | rejected | withdrawn
  status: String
  proposed_by: String
  reviewed_by: String?
  reviewed_at: DateTime?
  review_note: String?
  created_at: DateTime
}
