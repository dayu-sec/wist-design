// Module: AgentCredential — Agent 身份与凭据逻辑
//
// AgentIdentity 的逻辑（逻辑型 module<service>）：凭据续期、凭据校验命令与校验流程，
// 身份/凭据实体事实由 AgentIdentity 承载。

message<command> RenewAgentCredential {
  api_version: String
  kind: String
  agent_id: String
  instance_id: String
  credential_request: String
  requested_at: DateTime
}

command VerifyAgentCredential {
  agent_id: String
  instance_id: String
  credential: String
  requested_at: DateTime
}

flow VerifyAgentCredentialFlow {
  meta {
    label zh "校验 Agent 通讯凭据"
    label en "Verify Agent Credential Flow"
    tags "agentd", "credential", "verification"
  }

  actor Agentd
  trigger VerifyAgentCredential

  depends AgentIdentity, CredentialBundle, AgentControlAuthProfile

  creates AgentCredentialVerificationResult

  step<stop> VerifyCredential {
    create AgentCredentialVerificationResult {
      agent_id = VerifyAgentCredential.agent_id
      instance_id = VerifyAgentCredential.instance_id
      status = "verified"
      verified_at = VerifyAgentCredential.requested_at
    }

  }
}

verify AgentCredentialVerificationVerified for flow VerifyAgentCredentialFlow {
  given {
    VerifyAgentCredential.agent_id = "agent-issued"
    VerifyAgentCredential.instance_id = "instance-issued"
    VerifyAgentCredential.requested_at = "2026-07-04T00:05:00Z"
  }

  when VerifyAgentCredential

  expect {
    AgentCredentialVerificationResult.status == "verified"
  }
}

// 签发 agent 客户端证书（mTLS）：注册与续期共用这一条签发路径。
// CSR 只贡献公钥，主体（URI SAN）由网关按稳定哈希 agent_id 填；有效期与回拨取
// AgentCertificatePolicy。设计见 docs/design/agent-identity-mtls.md §4.2。
command IssueAgentClientCertificate {
  agent_id: String
  instance_id: String
  csr_pem: String
  requested_at: DateTime
}

flow IssueAgentClientCertificateFlow {
  meta {
    label zh "签发 Agent 客户端证书"
    label en "Issue Agent Client Certificate Flow"
    summary zh "用独立 agent CA 签一张客户端证书：CSR 只贡献公钥，主体（URI SAN）由网关按稳定哈希 agent_id 填；有效期 37 天、notBefore 回拨 5 分钟。"
    tags "agentd", "certificate", "issuance"
  }

  actor Agentd
  trigger IssueAgentClientCertificate

  depends AgentCertificateAuthority, AgentCertificatePolicy, AgentClientCertificate

  creates AgentClientCertificate

  step<stop> IssueCertificate {
    create AgentClientCertificate {
      certificate_id = "cert-issued"
      agent_id = IssueAgentClientCertificate.agent_id
      ca_id = "agent-ca-default"
      serial = "00"
      fingerprint_sha256 = "sha256-issued"
      subject_uri = "spiffe://tenant-default/env-default/agent/agent-issued"
      not_before = IssueAgentClientCertificate.requested_at
      not_after = IssueAgentClientCertificate.requested_at
      issued_at = IssueAgentClientCertificate.requested_at
      status = "active"
    }
  }
}

verify IssueAgentClientCertificateVerified for flow IssueAgentClientCertificateFlow {
  given {
    IssueAgentClientCertificate.agent_id = "agent-issued"
    IssueAgentClientCertificate.instance_id = "instance-issued"
    IssueAgentClientCertificate.requested_at = "2026-09-28T00:00:00Z"
  }

  when IssueAgentClientCertificate

  expect {
    AgentClientCertificate.agent_id == "agent-issued"
    AgentClientCertificate.status == "active"
  }
}
