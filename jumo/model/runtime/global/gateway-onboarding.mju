// runtime/global：跨子系统全局编排 flow（domain 声明指定归属域）
// GatewayOnboardingFlow：从中心创建、带外交付、link-upstream、注册（CSR→证书）到 mTLS 上报的端到端编排。
//
// 与早期设计不同：**网关默认独立运行**，与中心集成是**可选的、事后的一步**（入口 = link-upstream）；
// 不再假设「中心下发容器 + 安装时注入 bootstrap，容器自做 init」。集成动作由**网关侧**（宿主常驻）发起。
// 长期身份是**网关专属客户端证书**（mTLS），不再是可复制的运行期 bearer。
// 泳道：中心（WistCenter）与网关（WistGateway）两侧。
// 业务管理员创建实例；客户服务工程师带外携带接入券到现场；网关侧 link-upstream、注册、周期 mTLS 上报。
domain Control
flow GatewayOnboardingFlow {
  meta {
    label zh "Gateway 接入整体流程"
    label en "Gateway Onboarding Flow"
    summary zh "WistGateway 从中心创建、带外交付接入券、link-upstream 置备、注册（CSR → 客户端证书）到 mTLS 上报的端到端编排；业务管理员（BusinessAdministrator）中心侧创建、客户服务工程师（CustomerServiceEngineer）现场带外交付；泳道：中心（WistCenter）/ 网关（WistGateway）。"
    tags "gateway", "onboarding", "enrollment", "mtls"
  }

  actor BusinessAdministrator
  actor CustomerServiceEngineer

  lane WistCenter for Control.InsightCenterApp.WistCenter
  lane WistGateway for Control.GatewayApp.Application

  depends GatewayLinkToken, ControlCenterTrustBundle

  creates GatewayEnrollmentToken
  creates GatewayInitialConfig
  creates GatewayClientCertificate
  creates GatewayStatusAccepted

  // ① 业务管理员经中心管理台创建实例——由 AdminCreateGatewayInstanceFlow.CreateInstance 承载；
  // 本步骤是时间线标记（创建动作不在本 flow 重复），不消费实例。
  step CreateGatewayInstance in WistCenter by AdminCreateGatewayInstance {
    next IssueLinkToken
  }

  // ② 中心签发一次性接入券（LINK_TOKEN，只存 sha256，短 TTL，绑定实例）——由
  // AdminCreateGatewayInstanceFlow.IssueLinkToken 承载；本步骤是时间线标记，不消费 token。
  step IssueLinkToken in WistCenter {
    next RevealLinkToken
  }

  // ③ 中心「连接 Gateway」页一次性展示接入券 明文（只存 sha256；明文仅此一次展示、不入 create API 响应；
  // 刷新即丢，再取即轮换）。展示即读取系统内记录，无需外部输入；工程师线下携带、现场交给网关侧。
  step RevealLinkToken in WistCenter {
    next ReceiveLinkToken
  }

  // ④ 网关侧（宿主常驻）带外取得入场券与中心信任锚——**信任起点不经网络**。网关默认独立运行，
  // 只有需要集成时才走到这里。
  step ReceiveLinkToken in WistGateway {
    receive GatewayLinkToken from input
    receive ControlCenterTrustBundle from input
    next LinkUpstream
  }

  // ⑤ 网关侧先校中心 HTTPS 证书（对照 ④ 注入的 ControlCenterTrustBundle），通过后才上送接入券，防 MITM。
  // 随后调 link-upstream（Bearer 一次性接入券）。
  step LinkUpstream in WistGateway by LinkUpstream {
    next ValidateLinkToken
  }

  // ⑥ 中心校验并一次性消费接入券：比对 token_hash、校验 gateway_id 绑定、未超期（超期 → Expired）；
  // 消费后 status → Consumed；仅 lifecycle_state = Provisioned 的实例可 init，防重放与重复置备。
  step ValidateLinkToken in WistCenter {
    next DeriveRegistToken
  }

  // ⑦ 中心派生 REGIST_TOKEN 落 enrollment、构建 config.toml（携带信任锚、引用注册 Token、control 端点、TLS 开关）。
  step DeriveRegistToken in WistCenter {
    create GatewayEnrollmentToken {
      token_id = "enroll-regist-001"
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      token_hash = "sha256:regist-token-hash"
      max_uses = 1
      used_count = 0
      status = "Active"
      issued_at = "now"
      expires_at = "2026-08-16T00:00:00Z"
    }
    create GatewayInitialConfig {
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      control_center_endpoint = "https://center.warpinsight.example"
      trust_bundle = ControlCenterTrustBundle
      server_tls_required = true
      protocol_version = "1.0"
      enrollment_token_id = "enroll-regist-001"
    }
    next ApplyInitialConfig
  }

  // ⑧ 网关侧应用 config.toml（写盘、以新配置进入初始化态，完成 init）。
  step ApplyInitialConfig in WistGateway {
    receive GatewayInitialConfig from DeriveRegistToken
    next GenerateKeypair
  }

  // ⑨ 网关侧**当场生成密钥对**（私钥永不出本机），产出 CSR——这是「换钥匙」的准备。
  step GenerateKeypair in WistGateway {
    next SubmitRegistration
  }

  // ⑩ 网关侧持 REGIST_TOKEN + CSR 注册（一次性消费注册凭据）。
  step SubmitRegistration in WistGateway by RegisterGateway {
    receive GatewayEnrollmentToken from DeriveRegistToken
    next IssueClientCertificate
  }

  // ⑪ 中心用网关专属 CA（CA-G，与服务器证书的 CA 单开）按 CSR 签一张**网关专属**客户端证书（subject = gateway_id），
  // 取代运行期 bearer，作为长期身份。
  step IssueClientCertificate in WistCenter {
    create GatewayClientCertificate {
      certificate_id = "cert-issued"
      gateway_id = AdminCreateGatewayInstance.gateway_name
      serial = "cert-serial-issued"
      certificate = "gateway-client-certificate-pem"
      issued_at = "now"
      not_after = "2026-11-16T00:00:00Z"
      status = "Active"
    }
    next InstallClientCertificate
  }

  // ⑫ 网关侧落盘客户端证书（私钥已在 ⑨ 本地生成，从未外传）；此后以 mTLS 认人，不再有可复制的凭据。
  step InstallClientCertificate in WistGateway {
    receive GatewayClientCertificate from IssueClientCertificate
    next ReportGatewayStatus
  }

  // ⑬ 网关侧以客户端证书做 mTLS，周期上报运行状态（绑定具体实例）。
  step<stop> ReportGatewayStatus in WistGateway {
    create GatewayStatusAccepted {
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      accepted_at = "now"
    }
  }
}
