// WistGateway WEB Layout index
//
// Keep this file at page/navigation level. Page internals and reusable
// regions live under ./layout/*.mju so GUI layout overview stays readable.

region AdminTopNavigation {
  meta {
    label zh "顶部导航"
    label en "Top Navigation"
    summary zh "WistGateway 的顶部导航区，作为各独立页面共享的页面级导航，提供首页、初始化、安装、安装包地址、控制中心与灰度发布入口，并展示在线业务区和操作者上下文。"
    tags "admin", "navigation", "top-navigation", "layout-index"
  }

  orientation horizontal
}

region<page> AdminHomePage {
  meta {
    label zh "首页"
    label en "Home"
    summary zh "WistGateway 的独立首页，面向 20 到 50 个常见 Agent、最多 200 个 Agent 的客户环境，只展示存在异常的 Agent 卡片；正常 Agent 不在首页主体中显示。"
    tags "admin", "home", "page", "agent-status", "abnormal-agent-only"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AgentStatusOverviewMetrics { slot_usecase: GetAgentOverview }
  contains RecentOnlineRegisteredAgentPanel { slot_usecase: GetAgentOverview }
  contains AbnormalAgentPanel { slot_usecase: GetAgentOverview }
  layout fill_remaining
}

region<page> AgentInstallPage {
  meta {
    label zh "安装"
    label en "Install"
    summary zh "WistGateway 的独立安装页，只提供 X86-Linux 和 Arm-Linux 两个 Agent 安装代码；无需输入租户、环境或其它参数，也不展示安装说明。"
    tags "admin", "agent-install", "install-code", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AgentInstallCodeList { slot_usecase: GetAgentInstallCode }
  layout fill_remaining
}

region<page> AgentControlCenterPage {
  meta {
    label zh "控制中心"
    label en "Control Center"
    summary zh "WistGateway 的独立控制中心页，面向已接入 Agent，集中承载对该 Agent 的控制任务。"
    tags "admin", "agent-control", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AdminOperatorLane { slot_actor: AdminOperator }
  contains AgentControlUsecaseBoard
  layout fill_remaining
}

region<page> GatewayInitializePage {
  meta {
    label zh "网关初始化"
    label en "Gateway Initialize"
    summary zh "WistGateway 的独立初始化页：输入控制中心初始化 URL（init_url）与可选 Bearer，检查是否已初始化后获取网关初始配置。Bearer 仅通过 Authorization Header 发送。"
    tags "admin", "gateway", "initialize", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains GatewayInitializeUsecaseCard { slot_usecase: InitializeGatewayViaUrl }
  layout fill_remaining
}

region<page> AgentInstallPackagePage {
  meta {
    label zh "安装包来源"
    label en "Install Package Source"
    summary zh "WistGateway 的独立设置页：查看并修改网关的 wist-agentd 取包来源地址（https 链接或主机绝对路径）与可选 sha256 期望摘要。安装端始终从网关取包；保存时网关先把该来源的制品拉到本地缓存，因此改动只影响之后新签发的安装代码与 install.sh，已分发的安装命令不变。"
    tags "admin", "agent-install", "package", "settings", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AgentInstallPackageUsecaseCard { slot_usecase: SetAgentInstallPackageAddress }
  layout fill_remaining
}

region<page> RolloutPlansPage {
  meta {
    label zh "灰度发布"
    label en "Rollout Plans"
    summary zh "WistGateway 的灰度发布计划页：列出机队级的灰度发布计划，并创建草稿（动作 + 分阶段范围 + 阶段内并发）。计划是编排层，不在此页批准或推进。"
    tags "admin", "rollout", "plan", "gray-release", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains RolloutPlanListPanel { slot_usecase: ListRolloutPlans }
  contains RolloutPlanCreateCard { slot_usecase: CreateRolloutPlan }
  layout fill_remaining
}

region<page> RolloutPlanDetailPage {
  meta {
    label zh "灰度发布计划详情"
    label en "Rollout Plan Detail"
    summary zh "WistGateway 的灰度发布计划详情页：查看一份计划及其逐目标进度，并承载灰度发布的两处人工闸门（批准进入第一阶段 / 确认无问题后推进下一阶段）。"
    tags "admin", "rollout", "plan", "gray-release", "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains RolloutPlanDetailPanel { slot_usecase: ViewRolloutPlan }
  contains RolloutPlanGates { slot_usecase: ApproveRolloutPlan }
  layout fill_remaining
}
