// 系统分解：顶层子系统边界

subsystem WistGateway {
  meta {
    label zh "控制平台"
    summary zh "中心侧控制、治理、编译、下发、跟踪与风险控制。"
    tag "control-plane"
  }

  uses module Control.GatewayApp.WebFrontend
  uses module Control.GatewayApp.UserFacingInterface, Control.AgentApp.FacingInterface, Control.GatewayApp.SelfInterface
  uses module Control.Agent.Enrollment, Control.Agent.Registration, Control.Agent.Identity, Control.Agent.Credential, Control.Agent.Status
  uses module Control.Agent.Certificate
  uses module Control.Agent.Command
  // 网关**服务**工作授权（`WorkGrant` / `AckWork` / `AgentUplinkGrant` 都是这里下发的），
  // 所以工作域属于本子系统 —— 之前漏了这行，导致 `Control.Agent.Work` 整体不在任何 scope 里，
  // `jumo-code diff` 从不检查它（包括 `AgentUplinkGrant` 这个跨端线格式）。
  uses module Control.Agent.Work
  uses module Control.Rollout
  uses module Control.Protocol, Control.Agent.Registry, Control.Agent.Status
  uses module Control.Gateway.Management, Control.Gateway.Management
  uses module Control.GatewayApp.Application
}
