// WistGateway 子系统用例

// 通过 URL 初始化
usecase InitializeGatewayViaUrl {
  meta {
    label zh "通过 URL 初始化"
    label en "Initialize Gateway via URL"
    summary zh "WistGateway 实例安装后由客户服务工程师输入控制中心初始化 URL 与可选 Bearer，Gateway 先检查本地初始化状态，再由 Center 校验 GatewayInstance；任一侧已初始化即拒绝，未初始化时通过 Authorization Header 携带凭证获取并应用初始配置。"
    tags "gateway", "bootstrap", "initialize", "config"
  }

  actor Control.CustomerServiceEngineer
  trigger Control.InitializeGatewayViaUrl
  outcome Control.GatewayInitialConfig
  flow Control.InitializeGatewayViaUrlFlow
}

// 通过 init-url 置备（GetGatewayInitialConfigFlow：bootstrap 鉴权 + 身份派生 REGIST → config.toml）
usecase InitGatewayViaInitialConfig {
  meta {
    label zh "通过 init-url 置备"
    label en "Init Gateway via Initial Config"
    summary zh "WistGateway 持一次性 BootstrapToken 调 initial-config：消费引导、上交 IdentityToken，center 派生 RegistToken 生成 config.toml，完成置备。"
    tags "gateway", "bootstrap", "provisioning", "config"
  }

  actor Control.WistGateway
  trigger Control.GetGatewayInitialConfig
  outcome Control.GatewayInitialConfig
  outcome Control.GatewayEnrollmentToken
  flow Control.GetGatewayInitialConfigFlow
}

// 注册到 WistCenter（消费 RegistToken → 签发独立运行期凭据）
usecase RegisterToInsightCenter {
  meta {
    label zh "注册到 WistCenter"
    label en "Register to WistCenter"
    summary zh "WistGateway 持 config.toml 中的 RegistToken 注册：center 消费注册凭据并签发独立运行期凭据（RUNTIME_TOKEN），网关进入中心监管视图。"
    tags "gateway", "register", "credential", "supervision"
  }

  actor Control.WistGateway
  trigger Control.RegisterGateway
  outcome Control.GatewayEnrollmentResult
  outcome Control.GatewayCredentialBundle
  flow Control.RegisterGatewayFlow
}

// 续期运行期凭据（旧凭据立即失效）
usecase RenewGatewayCredential {
  meta {
    label zh "续期网关运行期凭据"
    label en "Renew Gateway Credential"
    summary zh "网关凭当前 RUNTIME_TOKEN 申请新运行期凭据，旧凭据立即失效，实现定期轮换。"
    tags "gateway", "credential", "renewal"
  }

  actor Control.WistGateway
  trigger Control.RenewGatewayCredential
  outcome Control.GatewayCredentialBundle
  flow Control.RenewGatewayCredentialFlow
}

// 上报网关状态（运行期心跳）
usecase ReportGatewayStatus {
  meta {
    label zh "上报网关状态"
    label en "Report Gateway Status"
    summary zh "网关周期以 RUNTIME_TOKEN 上报运行状态，center 落库并进入监控视图。"
    tags "gateway", "status", "runtime"
  }

  actor Control.WistGateway
  trigger Control.ReportGatewayStatus
  outcome Control.GatewayStatusAccepted
  flow Control.ReportGatewayStatusFlow
}

// 获取 Agent 安装代码
usecase GetAgentInstallCode {
  meta {
    label zh "获取 Agent 安装代码"
    label en "Get Agent Install Code"
    tags "agent-install", "install-code", "public"
  }

  actor Control.OperationsEngineer
  trigger Control.GetAgentInstallCode
  outcome Control.AgentInstallCode
}

// 获取 Agent 总览
usecase GetAgentOverview {
  meta {
    label zh "获取 Agent 总览"
    label en "Get Agent Overview"
    tags "agent-status", "overview", "admin", "home"
  }

  actor Control.AdminOperator
  trigger Control.GetAgentOverview
  outcome Control.AgentOverview
}

// 展示 Agent 的运行状态
usecase ShowAgentRuntimeStatus {
  meta {
    label zh "展示 Agent 的运行状态"
    label en "Show Agent Runtime Status"
    tags "agent-status", "admin"
  }

  actor Control.AdminOperator
  trigger Control.ShowAgentRuntimeStatus
  outcome Control.AgentRuntimeStatus
}

// 设置 wist-agentd 安装包来源地址
usecase SetAgentInstallPackageAddress {
  meta {
    label zh "设置 wist-agentd 安装包来源地址"
    label en "Set wist-agentd Install Package Source"
    summary zh "平台维护工程师设置网关的取包来源地址与可选期望摘要；设置时网关先把该来源的制品拉到本地缓存，之后新签发的安装代码与 bootstrap bundle 都分发这份缓存，已签发且未过期的安装代码不受影响。拉取失败或摘要不符则整次操作失败，不改变现有设置。"
    tags "agent-install", "package", "admin"
  }

  actor Control.PlatformMaintenanceEngineer
  trigger Control.SetAgentInstallPackageAddress
  outcome Control.AgentInstallPackageAddress
}

// 查看当前生效的 wist-agentd 安装包来源地址
usecase ViewAgentInstallPackageAddress {
  meta {
    label zh "查看 wist-agentd 安装包来源地址"
    label en "View wist-agentd Install Package Source"
    summary zh "安装运维查看网关当前的取包来源地址与制品摘要，用于确认之后下发的安装代码会装哪个包；未设置过时返回空的来源地址，表示网关分发它内置的安装包。"
    tags "agent-install", "package", "admin"
  }

  actor Control.OperationsEngineer
  trigger Control.ViewAgentInstallPackageAddress
  outcome Control.AgentInstallPackageAddress
}

// 接收 Agent 上报的事实摘要并推断用途
usecase IngestAgentFactSummary {
  meta {
    label zh "接收事实摘要并推断用途"
    label en "Ingest Agent Fact Summary and Infer Purpose"
    summary zh "网关收到 agentd 上报的事实摘要（去重后的进程/包/端口）：按 content_digest（网关自算）幂等入库（覆盖式，一台一条），再按该机器平台的规则表算出用途建议与逐条依据供人判定。重复摘要只刷留痕，不重写内容也不重复计分。"
    tags "agent-fact", "purpose", "discovery", "ingest"
  }

  actor Control.Agentd
  trigger Reporting.ReportAgentFactSummary
  outcome Control.AgentFactSummary
  outcome Control.AgentSoftwareEntry
  outcome Control.PurposeSuggestion
  flow Reporting.IngestAgentFactSummaryFlow
}

// 向 Agent 下发发现方向策略表（各方向的观测周期）
usecase ServeDiscoveryPolicies {
  meta {
    label zh "下发发现方向策略表"
    label en "Serve Discovery Aspect Policies"
    summary zh "网关向 agentd 交付平台策展的发现方向策略表（各方向的观测周期与允许区间）。网关未配表时不提供该端点：agentd 继续用自己的内建默认值，行为与策略表引入前一致。"
    tags "discovery", "policy", "agentd", "serve"
  }

  actor Control.Agentd
  trigger Reporting.PollDiscoveryPolicies
  outcome Discovery.DiscoveryAspectPolicySet
}

// 查看当前生效的发现方向策略表
usecase ViewDiscoveryPolicies {
  meta {
    label zh "查看发现方向策略表"
    label en "View Discovery Aspect Policies"
    summary zh "运维查看网关当前生效的发现方向策略表：未配置时如实回报未配置，不编造一份默认表 —— 默认值是 agentd 的内建行为，不是平台发布的策略。"
    tags "discovery", "policy", "admin", "view"
  }

  actor Control.AdminOperator
  trigger Control.AdminViewDiscoveryPolicies
  outcome Control.DiscoveryPolicyView
}

// 查看 Agent 用途
usecase ViewAgentPurpose {
  meta {
    label zh "查看 Agent 用途"
    label en "View Agent Purpose"
    summary zh "管理员查看某台 Agent 的用途：agentd 上报的事实摘要、网关推陈的建议（含逐条依据与置信度）、人工判定三者并列展示；尚未上报事实时事实与建议为空，不伪造结论。"
    tags "agent-fact", "purpose", "admin", "view"
  }

  actor Control.AdminOperator
  trigger Control.AdminViewAgentPurpose
  outcome Control.AgentPurposeView
}

// 归档 Agent 用途判定（人工判定）
usecase ClassifyAgentPurpose {
  meta {
    label zh "归档 Agent 用途判定"
    label en "Classify Agent Purpose"
    summary zh "管理员把某台 Agent 的用途判定归档：采纳网关建议或人工改判，落 AgentClassification（含判定人与时间）；分类必须与机器平台一致。这是按机器类别授权工作模板的前置。"
    tags "agent-purpose", "classification", "admin"
  }

  actor Control.AdminOperator
  trigger Control.AdminClassifyAgent
  outcome Control.AgentClassification
}

// 查看机队用途覆盖度（各类别台数 + 未归类）
usecase ViewPurposeCoverage {
  meta {
    label zh "查看机队用途覆盖度"
    label en "View Fleet Purpose Coverage"
    summary zh "管理员查看机队按机器类别归类的覆盖度：总数 / 已归类 / 未归类，以及各类别台数。让『4 类覆盖多少』从断言变成一个可度量的数，也为是否要扩 MachineClass 提供基数。"
    tags "agent-purpose", "coverage", "admin", "view"
  }

  actor Control.AdminOperator
  trigger Control.AdminViewPurposeCoverage
  outcome Control.FleetPurposeCoverage
}

// 查看 Agent 软件清单（按机器看软件）
usecase ViewAgentSoftware {
  meta {
    label zh "查看 Agent 软件清单"
    label en "View Agent Software"
    summary zh "管理员按机器查看从事实摘要机械归并出的软件清单（可执行路径 → 聚类键 + 展示名）；未知 agent 回 404，有 agent 但没上报过清单则为空清单。"
    tags "agent-inventory", "software", "admin", "view"
  }

  actor Control.AdminOperator
  trigger Control.AdminViewAgentSoftware
  outcome Control.AgentSoftwareInventory
}

// 按软件看机器（机队聚合）
usecase ViewSoftwareHoldings {
  meta {
    label zh "按软件看机器"
    label en "View Software Holdings"
    summary zh "管理员按软件聚类键查看机队持有情况：哪些机器装了、各在哪条路径；受 limit 约束返回前 N 个聚类键。"
    tags "agent-inventory", "software", "admin", "view"
  }

  actor Control.AdminOperator
  trigger Control.AdminViewSoftwareHoldings
  outcome Control.SoftwareHoldings
}

// 授权或更新某台 Agent 的工作（常驻按面、一次性按动作）
usecase GrantAgentWork {
  meta {
    label zh "授权 Agent 工作"
    label en "Grant Agent Work"
    summary zh "管理员给某台 Agent 授权工作：常驻工作按采集面授权（一个面一份，spec 由采集目录按该机器事实展开或逐条校验），一次性工作按动作授权（带计划开始、绝对截止与执行预算）。授权闸门是面就绪度：规则未就绪的面不许授权；用途判定是前置，没有判定就没有机器类别、取不到模板。"
    tags "agent-work", "grant", "admin"
  }

  actor Control.AdminOperator
  trigger Control.AdminGrantWork
  outcome Control.WorkReceipt
  flow Control.AdminGrantWorkFlow
}

// 撤回某台 Agent 的一份工作
usecase RevokeAgentWork {
  meta {
    label zh "撤回 Agent 工作"
    label en "Revoke Agent Work"
    summary zh "管理员撤回某台 Agent 的一份工作：常驻工作撤销授权（从 revoked 恢复要走新的提案加审定），一次性工作取消未了结的活。撤回不删行，留痕供审计。"
    tags "agent-work", "revoke", "admin"
  }

  actor Control.AdminOperator
  trigger Control.AdminRevokeWork
  outcome Control.WorkReceipt
  flow Control.AdminRevokeWorkFlow
}

// 暂停某台 Agent 的一份工作
usecase PauseAgentWork {
  meta {
    label zh "暂停 Agent 工作"
    label en "Pause Agent Work"
    summary zh "管理员暂停某台 Agent 的一份工作：常驻工作的暂停是期望状态的一部分（保留授权与版本，Agent 没在做不算漂移）；一次性工作只有可中断且正在执行时才允许暂停，不可中断的动作一律拒绝，而不是尽力暂停。"
    tags "agent-work", "pause", "admin"
  }

  actor Control.AdminOperator
  trigger Control.AdminPauseWork
  outcome Control.WorkReceipt
  flow Control.AdminPauseWorkFlow
}

// 继续某台 Agent 被暂停的工作
usecase ResumeAgentWork {
  meta {
    label zh "继续 Agent 工作"
    label en "Resume Agent Work"
    summary zh "管理员继续某台 Agent 被暂停的工作：仍用暂停前的同一版本，不重新审定；一次性工作从步级断点继续，并把本次暂停时长计入累计（暂停期间不消耗执行预算的依据）。"
    tags "agent-work", "resume", "admin"
  }

  actor Control.AdminOperator
  trigger Control.AdminResumeWork
  outcome Control.WorkReceipt
  flow Control.AdminResumeWorkFlow
}

// 向 Agent 交付工作授权快照
usecase ServeWorkGrant {
  meta {
    label zh "下发工作授权快照"
    label en "Serve Agent Work Grant"
    summary zh "网关向 agentd 交付工作授权快照：常驻工作的当前生效版本（含暂停的）加未了结的一次性工作，带授权序号。幂等、可重复拉取：断网或重启后重新拉一次就回到期望状态，网关不必记推到哪了。"
    tags "agent-work", "grant", "agentd", "serve"
  }

  actor Control.Agentd
  trigger Control.PollWork
  outcome Control.WorkGrant
  flow Control.PollWorkFlow
}

// 接收 Agent 的工作确认
usecase AcceptWorkAcknowledgement {
  meta {
    label zh "接收工作确认"
    label en "Accept Work Acknowledgement"
    summary zh "网关接收 agentd 对某份工作的确认：常驻工作比对生效版本（对不上回报 stale，请其重拉快照），一次性工作从已派发进到已接受。网关据此判断期望与实际是否一致，一直没确认的就是漂移。"
    tags "agent-work", "ack", "agentd"
  }

  actor Control.Agentd
  trigger Control.AckWork
  outcome Control.WorkAccepted
  flow Control.AckWorkFlow
}
