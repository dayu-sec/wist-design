// WistAgentd 子系统用例

// 注册管理中心
usecase RegisterWithManagementCenter {
  meta {
    label zh "注册管理中心"
    label en "Register With Management Center"
    tags "agent-register", "wp-agent"
  }

  actor Control.Agentd
  trigger Control.SubmitEnrollmentRequest
  outcome Control.AgentIdentity, Control.AgentEnrollmentResult
  flow Control.AgentdRegistrationFlow
  verify Control.AgentdRegistrationVerified
}

// 定期上报自己状态
usecase PeriodicallyReportSelfStatus {
  meta {
    label zh "定期上报自己状态"
    label en "Periodically Report Self Status"
    tags "agent-health", "wp-agent"
  }

  actor Control.Agentd
  trigger Reporting.AgentStatusReport
  outcome Reporting.RuntimeHealthSnapshot
  flow Reporting.AgentStatusReportFlow
  verify Reporting.AgentStatusReportVerified
}

// 采集日志
usecase CollectLogs {
  meta {
    label zh "采集日志"
    label en "Collect Logs"
    summary zh "按网关授权的工作采集日志：工作的单元指向哪些文件通配就采哪些（含数据面规则标识），本地运维在配置里手工加的采集单元作为逃生舱并存。没有授权就没有采集任务。"
    tags "log-collection", "wp-agent"
  }

  actor Discovery.Collector
  trigger Discovery.CollectLogs
  outcome Discovery.TelemetryBuffer
}

// 采集 Metric
usecase CollectMetrics {
  meta {
    label zh "采集 Metric"
    label en "Collect Metrics"
    summary zh "按网关授权的工作上送指标：只有持有生效的指标工作（`collect_metrics` 单元）才上送，周期取工作声明的最密值；没有授权就**不上送**，一个不做任务工作的 Agent 不该有顺手的默认指标。"
    tags "metric-collection", "wp-agent"
  }

  actor Discovery.Collector
  trigger Discovery.CollectMetrics
  outcome Discovery.MetricsSamplesSnapshot
}

// 拉取并应用网关授权的工作
usecase PullGrantedWork {
  meta {
    label zh "拉取并应用授权工作"
    label en "Pull Granted Work"
    summary zh "agentd 定期拉取工作授权快照并应用（日志任务、指标开关与周期），再按版本回报确认。幂等：断网或重启后重新拉一次就回到期望状态；拉不到快照时会先按**本地留痕的最后已知期望**继续干活（state/work/grant.json），而不是静默停采 —— 代价是断网期间撤回会晚一步生效。"
    tags "agent-work", "wp-agent", "polling"
  }

  actor Control.Agentd
  trigger Control.PollWork
  outcome Control.WorkGrant
  flow Control.PollWorkFlow
}
