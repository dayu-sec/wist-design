    {
      "name": "System.WistGateway.ViewSoftwareHoldings",
      "status": "Complete",
      "progress": 100,
      "flow": "Reporting.IngestAgentFactSummaryFlow",
      "entries": [
        {
          "name": "AdminViewSoftwareHoldings",
          "route": "GET /api/v1/admin/software",
          "handler": "wist-gateway:software_ops.rs:view_software_holdings"
        }
      ]
    },
    {
      "name": "System.WistGateway.GrantAgentWork",
      "status": "Partial",
      "progress": 80,
      "flow": "Control.AdminGrantWorkFlow",
      "entries": [
        {
          "name": "AdminGrantWork",
          "route": "POST /api/v1/admin/agents/:agent_id/work",
          "handler": "wist-gateway:admin_ops.rs:grant_work",
          "covers": ["StandingWork", "OneShotWork", "WorkReceipt"]
        }
      ],
      "gaps": [
        "一次性工作的 interruptible 一律按不可中断收（动作目录未就位），即暂时不允许运行中暂停",
        "proposal_id 恒为空：AdminProposeWork / AdminReviewWork 还没有代码落点"
      ]
    },
    {
      "name": "System.WistGateway.RevokeAgentWork",
      "status": "Partial",
      "progress": 80,
      "flow": "Control.AdminRevokeWorkFlow",
      "entries": [
        {
          "name": "AdminRevokeWork",
          "route": "POST /api/v1/admin/agents/:agent_id/work/:work_id/revoke",
          "handler": "wist-gateway:admin_ops.rs:revoke_work"
        }
      ],
      "gaps": ["reason_code 收下但未落库：审计事件（WorkRevoked）还没建"]
    },
    {
      "name": "System.WistGateway.PauseAgentWork",
      "status": "Partial",
      "progress": 80,
      "flow": "Control.AdminPauseWorkFlow",
      "entries": [
        {
          "name": "AdminPauseWork",
          "route": "POST /api/v1/admin/agents/:agent_id/work/:work_id/pause",
          "handler": "wist-gateway:admin_ops.rs:pause_work"
        }
      ],
      "gaps": ["一次性工作因 interruptible 一律为 false，实际只能暂停常驻工作"]
    },
    {
      "name": "System.WistGateway.ResumeAgentWork",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.AdminResumeWorkFlow",
      "entries": [
        {
          "name": "AdminResumeWork",
          "route": "POST /api/v1/admin/agents/:agent_id/work/:work_id/resume",
          "handler": "wist-gateway:admin_ops.rs:resume_work"
        }
      ]
    },
    {
      "name": "System.WistGateway.ServeWorkGrant",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.PollWorkFlow",
      "entries": [
        {
          "name": "PollWork",
          "route": "POST /api/v1/agent/work:poll",
          "handler": "wist-gateway:agent_ops.rs:poll_work",
          "covers": ["WorkGrant"]
        },
        {
          "name": "AdminViewAgentWork",
          "route": "GET /api/v1/admin/agents/:agent_id/work（手加端点：模型只声明了授权/撤回，没有查看）",
          "handler": "wist-gateway:admin_ops.rs:view_agent_work"
        }
      ],
      "gaps": ["wait_ms 未实现长轮询：现在一律立即返回"]
    },
    {
      "name": "System.WistGateway.AcceptWorkAcknowledgement",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.AckWorkFlow",
      "entries": [
        {
          "name": "AckWork",
          "route": "POST /api/v1/agent/work:ack",
          "handler": "wist-gateway:agent_ops.rs:ack_work",
          "covers": ["WorkAccepted"]
        }
      ]
    },
    {
      "name": "System.WistGateway.AcceptWorkResult",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.ReportWorkResultFlow",
      "entries": [
        {
          "name": "ReportWorkResult",
          "route": "POST /api/v1/agent/work:result",
          "handler": "wist-gateway:agent_ops.rs:submit_work_result",
          "covers": ["WorkResultAccepted"]
        },
        {
          "name": "ViewWorkResult",
          "route": "GET /api/v1/admin/agents/:agent_id/work（结果随工作在 one_shot[].result / settled_one_shot[].result 里带出）",
          "handler": "wist-gateway:admin_ops.rs:view_agent_work"
        }
      ]
    },
    {
      "name": "System.WistAgentd.PullGrantedWork",
      "status": "Partial",
      "progress": 75,
      "entries": [
        {
          "name": "PollWork",
          "route": "POST /api/v1/agent/work:poll（agentd 侧发起；从网关拉到授权快照后应用并确认）",
          "handler": "wist-agentd:control/work.rs:fetch_work_grant",
          "covers": ["WorkGrant"]
        },
        {
          "name": "AckWork",
          "route": "POST /api/v1/agent/work:ack（确认只对真正应用了的工作发，成功才记版本）",
          "handler": "wist-agentd:control/work.rs:ack_work",
          "covers": ["WorkAccepted"]
        },
        {
          "name": "ApplyWorkGrant",
          "route": "daemon 主循环：拉取→折算→确认（写入 runtime/daemon.rs:refresh_work_grant）",
          "handler": "wist-agentd:control/work.rs:apply",
          "covers": ["StandingWork", "WorkSpec"]
        },
        {
          "name": "DispatchOneShotWork",
          "route": "daemon 主循环：把 upgrade 交给分离进程 wist-upgrader（runtime/daemon.rs:dispatch_upgrade），与在飞的升级互斥",
          "handler": "wist-agentd:runtime/daemon.rs:dispatch_upgrade",
          "covers": ["OneShotWork"]
        },
        {
          "name": "ReportWorkResult",
          "route": "POST /api/v1/agent/work:result（报进度/终态；报不出去就不推进本机视图，下一轮重读记录重投）",
          "handler": "wist-agentd:control/work.rs:report_work_result",
          "covers": ["WorkResultAccepted"]
        }
      ],
      "gaps": [
        "只能承接 FileGlob（日志文件）与 MetricInterval（指标周期）两类来源；Exporter / UnifiedLogPredicate 如实报 WorkUnitUnsupported，不静默丢",
        "一次性工作只承接 upgrade（EXECUTABLE_ONE_SHOT_ACTIONS）；其余动作如实报 OneShotWorkNotExecuted，不起进程也不确认",
        "采集目录里没有 startup_position 字段，授权采集一律按 tail 起（不重放历史），要回放得本地配置",
        "本地留痕 state/work/grant.json 记最后已知期望（含已确认版本）：断网/重启后先按它干活，连上网关即回到期望 —— 代价是断网期间撤回会晚一步生效"
      ]
    },
    {
      "name": "System.WistAgentd.CollectLogs",
      "status": "Complete",
      "progress": 100,
      "entries": [
        {
          "name": "CollectLogsFromGrantedWork",
          "route": "daemon 采集 tick：配置 file_inputs + 工作折算出的输入（runtime/daemon_telemetry.rs:process_telemetry_inputs）",
          "handler": "wist-agentd:control/work.rs:log_inputs"
        }
      ]
    },
    {
      "name": "System.WistAgentd.CollectMetrics",
      "status": "Complete",
