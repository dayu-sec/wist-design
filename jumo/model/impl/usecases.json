          "name": "GateMetricsUplinkOnGrantedWork",
          "route": "daemon 主循环：无生效指标工作则不上送，有则按工作声明的最密周期节流",
          "handler": "wist-agentd:control/work.rs:metrics_interval"
        }
      ]
    },
