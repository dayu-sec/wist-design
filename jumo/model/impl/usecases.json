    },
    {
      "name": "System.WistGateway.ApproveRolloutPlan",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.AdminApproveRolloutPlanFlow",
      "entries": [
        {
          "name": "AdminApproveRolloutPlan",
          "route": "POST /api/v1/admin/rollout-plans/approve",
