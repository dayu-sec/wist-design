      ]
    },
    {
      "name": "System.WistGateway.AdvanceRolloutPlan",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.AdminAdvanceRolloutPlanFlow",
      "entries": [
        {
          "name": "AdminAdvanceRolloutPlan",
          "route": "POST /api/v1/admin/rollout-plans/advance",
          "handler": "wist-gateway:rollout_ops.rs:advance_rollout_plan"
        }
      ]
    },
    {
      "name": "System.WistGateway.ViewRolloutPlan",
      "status": "Complete",
      "progress": 100,
      "flow": "Control.AdminViewRolloutPlanFlow",
      "entries": [
        {
          "name": "AdminViewRolloutPlan",
          "route": "GET /api/v1/admin/rollout-plans/{plan_id}",
